
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявкаНаИзменениеАД") Тогда
		
		Основание = ДанныеЗаполнения.Ссылка;
		Филиал = ДанныеЗаполнения.Филиал;
		Процесс = Справочники.Процессы.СогласованиеЗаявкиОИзмененииАД;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура РешениеПоКВПроверкаУсловия(ТочкаМаршрутаБизнесПроцесса, Результат)
	
	Результат = Истина;
	
	//Проверка ограничяений по продукту
	ПараметрыКонтроля = РегистрыСведений.AMS_ОграниченияВознагражденийПоПродукту.ПараметрыПроверкиОграничений();
	Для каждого СтраховойПродукт Из Основание.СтраховыеПродукты Цикл
		
		ПараметрыКонтроля.РазмерПремии = СтраховойПродукт.Процент;
		ПараметрыКонтроля.СтраховойПродукт = СтраховойПродукт.СтраховойПродукт;
		Проверка = РегистрыСведений.AMS_ОграниченияВознагражденийПоПродукту.ПроверитьОграниченияМаксимальногоКВ(ПараметрыКонтроля);
		
		Если НЕ Проверка Тогда
			
			Результат = Ложь;
			Возврат;
			
		КонецЕсли;		
		
	КонецЦикла;	
		
	// Проверка ограничений по приказу 174
	ПараметрыКонтроля = Документы.ПриказОМаксимальномРазмереКВ.ПараметрыПроверкиОграничений();
	ПараметрыКонтроля.Агент = Основание.Агент;
	
	Для каждого СтраховойПродукт Из Основание.СтраховыеПродукты Цикл
	
		Если СтраховойПродукт.Отменен Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ПараметрыКонтроля.РазмерКВ = СтраховойПродукт.Процент;
		ПараметрыКонтроля.СтраховойПродукт = СтраховойПродукт.СтраховойПродукт;
		Проверка = Документы.ПриказОМаксимальномРазмереКВ.ПроверитьОграниченияМаксимальногоКВ(ПараметрыКонтроля);
		
		Если НЕ Проверка Тогда
			
			Результат = Ложь;
			Возврат;
			
		КонецЕсли;	
				
	КонецЦикла;

	Если Результат = Истина Тогда
		
		РегистрыСведений.СостояниеЗаявокНаИзменениеАД.УстановитьСтатус(Основание, ПредопределенноеЗначение("Справочник.СтатусыЗаявок.ВРаботе"));
		Контекст = Новый Структура("Номер", Основание.Номер);
		СообщенияПользователямКлиентСервер.СоздатьСообщение(Справочники.ШаблоныПисем.Согласование,
						Основание.Ответственный, Контекст);
		
	КонецЕсли;	
	
КонецПроцедуры	
	
Процедура ДоработкаКВПроверкаУсловия(ТочкаМаршрутаБизнесПроцесса, Результат)
	
	Если Основание.Отклонена Тогда
		Результат = Ложь;
	    Возврат;
	КонецЕсли;
	
	Если Основание.НаДоработку Тогда
		Результат = Истина;
	    Возврат;
	КонецЕсли;	
		
КонецПроцедуры

Процедура СогласованоКВПроверкаУсловия(ТочкаМаршрутаБизнесПроцесса, Результат)

	Результат = НЕ Основание.Отклонена;
	Если НЕ Результат Тогда
		
		Контекст = Новый Структура("Номер", Основание.Номер);
		СообщенияПользователямКлиентСервер.СоздатьСообщение(Справочники.ШаблоныПисем.ЗаявкаОтклонена,
						Основание.Ответственный, Контекст);
	КонецЕсли;	
		
КонецПроцедуры


Процедура ЗаявкаВРаботеПриСозданииЗадач(ТочкаМаршрутаБизнесПроцесса, ФормируемыеЗадачи, Отказ)

	Доработка = Ложь;
	
	Если Основание.НаДоработку Тогда
		
		ОснованиеОбъект = Основание.ПолучитьОбъект();
		ОснованиеОбъект.ЗаявкаНаСогласовании = Ложь;
		ОснованиеОбъект.Записать(РежимЗаписиДокумента.Запись);
		Доработка = Истина;
		
	КонецЕсли;	
	
	
	Для каждого ЗадачаПользователя Из ФормируемыеЗадачи Цикл
	
		ЗаполнитьЗначенияСвойств(ЗадачаПользователя, ЭтотОбъект);
	    ЗадачаПользователя.Номер 	= Неопределено;
		ЗадачаПользователя.Процесс 	= Справочники.Процессы.СогласованиеЗаявкиОИзмененииАД;
		
		Если Доработка Тогда
			
			ЗадачаПользователя.Исполнитель = Основание.Ответственный;
			ЗадачаПользователя.Наименование = "Требуется доработка " + ОснованиеОбъект;
			
		КонецЕсли;	
		
	КонецЦикла;

КонецПроцедуры

Процедура ВРаботеПриСозданииЗадач(ТочкаМаршрутаБизнесПроцесса, ФормируемыеЗадачи, Отказ)
	

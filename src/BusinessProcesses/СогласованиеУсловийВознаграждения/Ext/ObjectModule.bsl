	СообщенияПользователямКлиентСервер.СоздатьСообщение(Справочники.ШаблоныПисем.СогласованоКВ,
						Основание.Ответственный, Контекст);
	
	Для каждого ЗадачаПользователя Из ФормируемыеЗадачи Цикл
	
		
	КонецЦикла;
	
	ИзменениеКВ = Документы.AMS_ИзменениеКВИндивидуальное.СоздатьДокумент();
	ИзменениеКВ.Заполнить(Основание);

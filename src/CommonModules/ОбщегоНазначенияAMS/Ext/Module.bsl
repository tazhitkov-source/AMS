#Область ЗаполнениеВидыКонтактнойИнформации

Процедура ЗаполнениеВидыКонтактнойИнформации() Экспорт
	
	ДанныеТелефон = Новый Массив();
	ДанныеEmail = Новый Массив();
	ДанныеАдрес = Новый Массив();	
	
	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыКонтактнойИнформации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыКонтактнойИнформации КАК ВидыКонтактнойИнформации
	|ГДЕ
	|	ВидыКонтактнойИнформации.Предопределенный";
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока РезультатЗапроса.Следующий() Цикл
		
		Элемент = РезультатЗапроса.Ссылка;
		
		Если Элемент.ЭтоГруппа Тогда
			
			КонтактнаяИнформацияСправочник = Элемент.ПолучитьОбъект();
			
			Если НЕ КонтактнаяИнформацияСправочник.Используется Тогда
				КонтактнаяИнформацияСправочник.Используется = Истина;
				ОбновлениеИнформационнойБазы.ЗаписатьДанные(КонтактнаяИнформацияСправочник);
			КонецЕсли;
			
		Иначе
			
			Если СтрНайти(Элемент.ИмяПредопределенныхДанных, "Телефон") > 0 Тогда
				ДанныеТелефон.Добавить(Элемент);
			ИначеЕсли СтрНайти(Элемент.ИмяПредопределенныхДанных, "Email") > 0 Тогда
				ДанныеEmail.Добавить(Элемент);
			ИначеЕсли СтрНайти(Элемент.ИмяПредопределенныхДанных, "ЮридическийАдрес") > 0 Тогда
				ДанныеАдрес.Добавить(Элемент);	
			ИначеЕсли СтрНайти(Элемент.ИмяПредопределенныхДанных, "ФактическийАдрес") > 0 Тогда
				ДанныеАдрес.Добавить(Элемент);
			ИначеЕсли СтрНайти(Элемент.ИмяПредопределенныхДанных, "ПочтовыйАдрес") > 0 Тогда
				ДанныеАдрес.Добавить(Элемент);
			КонецЕсли;
			
		КонецЕсли;
		
		
	КонецЦикла;
	
	ПорядковыйНомер = 1;
	Для Каждого Элемент Из ДанныеТелефон Цикл  
		
		ПараметрыВида = УправлениеКонтактнойИнформацией.ПараметрыВидаКонтактнойИнформации(Перечисления.ТипыКонтактнойИнформации.Телефон);
		ПараметрыВида.Вид = Справочники.ВидыКонтактнойИнформации[Элемент.ИмяПредопределенныхДанных];
		ПараметрыВида.МожноИзменятьСпособРедактирования = Истина;
		ПараметрыВида.Порядок = ПорядковыйНомер;
		УправлениеКонтактнойИнформацией.УстановитьСвойстваВидаКонтактнойИнформации(ПараметрыВида);
		
		ПорядковыйНомер = ПорядковыйНомер + 1;
		
	КонецЦикла;
	
	ПорядковыйНомер = 1;
	Для Каждого Элемент Из ДанныеEmail Цикл   
		
		ПараметрыВида = УправлениеКонтактнойИнформацией.ПараметрыВидаКонтактнойИнформации(Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
		ПараметрыВида.Вид = Справочники.ВидыКонтактнойИнформации[Элемент.ИмяПредопределенныхДанных];
		ПараметрыВида.МожноИзменятьСпособРедактирования = Истина;
		ПараметрыВида.Порядок = ПорядковыйНомер;
		УправлениеКонтактнойИнформацией.УстановитьСвойстваВидаКонтактнойИнформации(ПараметрыВида);
		
		ПорядковыйНомер = ПорядковыйНомер + 1;  
		
	КонецЦикла;
	
	ПорядковыйНомер = 1;
	Для Каждого Элемент Из ДанныеАдрес Цикл 
		
		ПараметрыВида = УправлениеКонтактнойИнформацией.ПараметрыВидаКонтактнойИнформации(Перечисления.ТипыКонтактнойИнформации.Адрес);
		ПараметрыВида.Вид = Справочники.ВидыКонтактнойИнформации[Элемент.ИмяПредопределенныхДанных];
		ПараметрыВида.МожноИзменятьСпособРедактирования = Истина;
		ПараметрыВида.Порядок = ПорядковыйНомер;
		УправлениеКонтактнойИнформацией.УстановитьСвойстваВидаКонтактнойИнформации(ПараметрыВида);
		
		ПорядковыйНомер = ПорядковыйНомер + 1;
		
	КонецЦикла;	
	
КонецПроцедуры


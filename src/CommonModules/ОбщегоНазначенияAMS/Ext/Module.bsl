		ПодканалПродажНПКП.Записать();
		
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Заполнение предопределенных данных", 
		УровеньЖурналаРегистрации.Информация, 
		Метаданные.Справочники.AMS_КаналыПродаж, 
		, "Данные заполнены");
		
	Исключение
		
		ОписаниеОшибки = ОписаниеОшибки();
		
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Заполнение предопределенных данных", 
		УровеньЖурналаРегистрации.Ошибка, 
		Метаданные.Справочники.AMS_КаналыПродаж, 
		, ОписаниеОшибки);
		
	КонецПопытки;
	
КонецПроцедуры	

// Возвращает Истина или Ложь.
// Проверяет имя на уникальность
//
// Параметры:
//  ИмяОбъекта - Строка
//  ИмяОбъекта = "AMS_МотивационныеПрограммы";
//
//  СтрРеквизитов - Структура.
//  СтрРеквизитов = Новый Структура; //
//  СтрРеквизитов.Вставить("Наименование", Объект.Наименование);
//
//  ЗначениеСсылка - Ссылка на объект
//  ЗначениеСсылка = Объект.Ссылка
//
&НаСервере
Функция ПрошелКонтрольУникальностиСправочникаПоРеквизиту(ИмяОбъекта, СтрРеквизитов, ЗначениеСсылка) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Спр.Ссылка
	|ИЗ
	|	Справочник." + ИмяОбъекта + " КАК Спр
	|ГДЕ
	|	Спр.Ссылка <> &парЗначениеСсылка
	|";
	
	Нум = 0;
	
	Для Каждого Знч Из СтрРеквизитов Цикл
		ИмяПараметраВЗапросе = " = &Пар" + Строка(Нум);
		Запрос.Текст = Запрос.Текст + " И Спр." + Знч.Ключ + ИмяПараметраВЗапросе; 
		Запрос.УстановитьПараметр("Пар" + Строка(Нум),	Знч.Значение);
		Нум = Нум + 1;
	КонецЦикла;
	
	Запрос.УстановитьПараметр("парЗначениеСсылка", 		ЗначениеСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Пустой();
	
КонецФункции

#КонецОбласти
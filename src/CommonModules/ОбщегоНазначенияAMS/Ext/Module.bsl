
Процедура ПриКопированииДокументовКВ(Источник, ОбъектКопирования, Отказ) Экспорт
	
	Источник.ГУИД = "";
	Источник.ГУИДЦССУ = "";
	
	Для каждого СтраховойПродукт Из Источник.СтраховыеПродукты Цикл
	
		КлючСвязи 	   = СтраховойПродукт.КлючСвязи;
		НовыйКлючСвязи = Строка(Новый УникальныйИдентификатор); 
		
		СтраховойПродукт.КлючСвязи = НовыйКлючСвязи;
		
		Отбор = Новый Структура("КлючСвязи", КлючСвязи);
		
		СтрокиПоказателей = Источник.Показатели.НайтиСтроки(Отбор);
		
		Для каждого Показатель Из СтрокиПоказателей Цикл
		
			Показатель.КлючСвязи = НовыйКлючСвязи;
		
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры

#Область ЗаполнениеСтандартныхРеквизитов

Процедура ЗаполнениеСтандартныхРеквизитов(Источник, Отказ = Ложь) Экспорт
	ЗаполнитьГУИДОбъекта(Источник, Отказ);
	ЗаполнитьОтветственного(Источник, Отказ);
КонецПроцедуры

#Область ЗаполнениеГУИД

//Заполнение реквизита ГУИД уникальным идентификатором ссылки объекта
//Выполняется при записи справочника с незаполненным реквизитом "ГУИД"
//Вызывается в модуле объекта в процедуре "ПередЗаписью"
Процедура ЗаполнитьГУИДОбъекта(Источник, Отказ = Ложь) Экспорт
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Источник, "ЭтоГруппа") И Источник.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;	
	
	Ссылка = Источник.Ссылка;
	
	Если Источник.ЭтоНовый() Тогда
		
		Если НЕ ЗначениеЗаполнено(Источник.ПолучитьСсылкуНового()) Тогда
			
			Менеджер = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Ссылка);
			НовыйОбъектСсылка = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор);
			Источник.УстановитьСсылкуНового(НовыйОбъектСсылка);
			
			Если ОпределитьТипОбъекта(Источник) = "Справочник" Тогда
				Источник.УстановитьНовыйКод();
			КонецЕсли;
			
		КонецЕсли;
		
		Ссылка = Источник.ПолучитьСсылкуНового();
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Источник.ГУИД) Тогда
		Источник.ГУИД = Строка(Ссылка.УникальныйИдентификатор());	
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнениеГУИДПредопределенныхЭлементовСправочников() Экспорт
	
	Запрос = Новый Запрос(ПолучитьТекстЗапроса());
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Ссылка = Выборка.Ссылка;
			НовыйОбъект = Ссылка.ПолучитьОбъект();
			НовыйОбъект.Записать();
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьТекстЗапроса()
	
	Результат = "";
	ИменаСправочников = ИменаСправочниковAMS();
	НомерТаблицы = 1;
	
	Для Каждого Имя Из ИменаСправочников Цикл
		Результат = Результат + ТекстДляТекущегоСправочника(Имя, Строка(НомерТаблицы));
		НомерТаблицы = НомерТаблицы + 1;
	КонецЦикла;
	
	Результат = Лев(Результат, СтрДлина(Результат) - 17);
	
	Возврат Результат;
	
КонецФункции

Функция ТекстДляТекущегоСправочника(Справочник, ПорядковыйНомер)
	
	Результат = "ВЫБРАТЬ
	|	ТекущаяТаблица%2.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.%1 КАК ТекущаяТаблица%2
	|ГДЕ
	|	ТекущаяТаблица%2.ГУИД = """"
	|	И ТекущаяТаблица%2.Предопределенный
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|";
	
	Результат = СтрШаблон(Результат, Справочник, ПорядковыйНомер);
	
	Возврат Результат;
	
КонецФункции


Функция ПолучитьТаблицуМакета(ИмяМакета, Менеджер) Экспорт

	МакетДанных  = Менеджер.ПолучитьМакет(ИмяМакета);
	ОбластьСтарт = МакетДанных.Область(1, 1, МакетДанных.ВысотаТаблицы, МакетДанных.ШиринаТаблицы);
	Построитель  = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ОбластьСтарт);
	Построитель.Выполнить();
	
	ТаблицаДанных = Построитель.Результат.Выгрузить();
	
	Возврат ТаблицаДанных;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедуры

Функция ИменаСправочниковAMS() Экспорт
	
	Результат = Новый Массив();
	
	Для Каждого СправочникМетаДанных Из Метаданные.Справочники Цикл
		
		Префикс = Лев(СправочникМетаДанных.Имя, 3);
		
		Если Префикс = "AMS" Тогда
			Результат.Добавить(СправочникМетаДанных.Имя);
		КонецЕсли;		
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ОпределитьТипОбъекта(Объект) Экспорт
	
	Результат = "";
	
	ТипЗначения = ТипЗнч(Объект);
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
	Если Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
		Результат = "Справочник";
	ИначеЕсли Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
		Результат = "Документ";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НеПроверяемыеРеквизиты) Экспорт
	
	Для Каждого ЭлементМассива Из НеПроверяемыеРеквизиты Цикл
		
		ПорядковыйНомер = ПроверяемыеРеквизиты.Найти(ЭлементМассива);
		Если ПорядковыйНомер <> Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(ПорядковыйНомер);
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

Функция ПолучитьСсылкаНаОтсутствующийОбъект(Идентификатор, ТипСправочника) Экспорт
	
	Результат = Справочники[ТипСправочника].ПустаяСсылка();
	
	Если НЕ Идентификатор = "" И НЕ Идентификатор = Неопределено Тогда 
		
		МенеджерСправочника		= Справочники[ТипСправочника];  
				
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Т.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник." + СокрЛП(ТипСправочника) + " КАК Т
		|ГДЕ
		|	(Т.ГУИД = &ГУИД
		|			ИЛИ Т.ГУИДЦССУ = &ГУИДЦССУ)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Т.Наименование УБЫВ";
		
		Запрос.УстановитьПараметр("ГУИД", Идентификатор);
		Запрос.УстановитьПараметр("ГУИДЦССУ", Идентификатор);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			СсылкаНаОбъект = ВыборкаДетальныеЗаписи.Ссылка;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СсылкаНаОбъект) Тогда 
			
			Объект = МенеджерСправочника.СоздатьЭлемент();
			
			Объект.ГУИДЦССУ = Идентификатор;
			
			Попытка 
				
				Объект.ГУИД = Идентификатор;
				
			Исключение
				
				// ГУИД отсутствует
				
			КонецПопытки;	
			
			Объект.ОбменДанными.Загрузка = Истина;
			
			Объект.Записать();
			
			СсылкаНаОбъект = Объект.Ссылка;
			
		КонецЕсли; 
		
		Результат = СсылкаНаОбъект;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


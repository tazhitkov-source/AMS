#Область СлужебныеПроцедурыИФункции

Функция ПолучитьМассивПродуктовОсновные()
	
	МассивПродуктов = Новый Массив;
	
	МассивПродуктов.Добавить(Перечисления.AMS_ВидыСтраховыхПродуктов.КАСКО);
	МассивПродуктов.Добавить(Перечисления.AMS_ВидыСтраховыхПродуктов.ЗКАСКО);
	МассивПродуктов.Добавить(Перечисления.AMS_ВидыСтраховыхПродуктов.Произвольный);
	МассивПродуктов.Добавить(Перечисления.AMS_ВидыСтраховыхПродуктов.Ответственность);
	МассивПродуктов.Добавить(Перечисления.AMS_ВидыСтраховыхПродуктов.НесчастныеСлучаи);
	МассивПродуктов.Добавить(Перечисления.AMS_ВидыСтраховыхПродуктов.ПредпринимательскиеРиски);
	МассивПродуктов.Добавить(Перечисления.AMS_ВидыСтраховыхПродуктов.ДГО);
	МассивПродуктов.Добавить(Перечисления.AMS_ВидыСтраховыхПродуктов.Грузы);
	МассивПродуктов.Добавить(Перечисления.AMS_ВидыСтраховыхПродуктов.ЛичноеСтрахование);
	МассивПродуктов.Добавить(Перечисления.AMS_ВидыСтраховыхПродуктов.СтрахованиеИмущества);
	МассивПродуктов.Добавить(Перечисления.AMS_ВидыСтраховыхПродуктов.ВЗР);
	МассивПродуктов.Добавить(Перечисления.AMS_ВидыСтраховыхПродуктов.КУГИ);
		
	Возврат МассивПродуктов;
	
КонецФункции

Функция ПолучитьМассивКаско()
	
	МассивКАСКО = Новый Массив;
	
	МассивКАСКО.Добавить(Перечисления.AMS_ВидыСтраховыхПродуктов.КАСКО);
	МассивКАСКО.Добавить(Перечисления.AMS_ВидыСтраховыхПродуктов.ЗКАСКО);
	
	Возврат МассивКАСКО;
	
КонецФункции

Процедура ИзменитьМассивПродуктов(МассивПродуктов)
	
	МассивПродуктов.Добавить(Перечисления.AMS_ВидыСтраховыхПродуктов.ОСОПО);
	МассивПродуктов.Добавить(Перечисления.AMS_ВидыСтраховыхПродуктов.ЗК);
	
	МассивПродуктов.Удалить(МассивПродуктов.Найти(Перечисления.AMS_ВидыСтраховыхПродуктов.ВЗР));
	МассивПродуктов.Удалить(МассивПродуктов.Найти(Перечисления.AMS_ВидыСтраховыхПродуктов.ДГО));
		
КонецПроцедуры

#КонецОбласти
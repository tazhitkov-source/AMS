Функция ОперативныйРасчетВознаграждения(Узел, СтруктураСообщения) Экспорт 
	
	Запрос = "/sorv/remuneration/calculate";
	ТипЗапроса = "POST";
	
	Результат = СформироватьИОтправитьСОРВ(Узел, СтруктураСообщения, Запрос, ТипЗапроса);
	
	Возврат Результат;
	
КонецФункции


#Область ОбработчикиСобытий

&НаСервере
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПолучитьДанныеИВывестиСхему(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПолучитьДанныеИВывестиСхему(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СхемаКомпоновкиДанных = ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	
	ПараметрКонкурс = Настройки.ПараметрыДанных.Элементы.Найти("КонкурсИлиРейтинг").Значение.ГУИД;
	
	Если ПараметрКонкурс = "" Тогда
		ОбщегоНазначения.СообщитьПользователю("Необходимо заполнить параметр ""Конкурс или рейтинг""");
		Возврат;
	КонецЕсли;
	
	Данные = ПолучитьДанныеИзМАМС(ПараметрКонкурс);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);	
	
	ВнешнийНаборДанных = Новый Структура("КонкурсыИРейтинги", Данные); 
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных; 
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешнийНаборДанных, ДанныеРасшифровки); 
	
	ДокументРезультат.Очистить();
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент; 
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат); 
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);

КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеИзМАМС(ПараметрКонкурс)
	
	СтруктураНастроек = ПолучитьСтруктуруНастроекМАМС();
	
	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
	
	АдресСайта = СтруктураНастроек.АдресСайта;
	HTTPСоединение = Новый HTTPСоединение(АдресСайта,,,,,30, ЗащищенноеСоединение);
	
	СтрокаЗапроса = СтрШаблон(СтруктураНастроек.API, ПараметрКонкурс);
	
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Accept", "*/*");
	Заголовки.Вставить("api-key", СтруктураНастроек.APIKEY);
	
	HTTPЗапрос = Новый HTTPЗапрос(СтрокаЗапроса, Заголовки);
	
	Попытка
		
		Ответ = HTTPСоединение.ВызватьHTTPМетод(СтруктураНастроек.Метод, HTTPЗапрос);
		
	Исключение
		
		ОбщегоНазначения.СообщитьПользователю("Ошибка вызова сервиса Master AMS: " + ОписаниеОшибки());
		Возврат Неопределено;
		
	КонецПопытки;
	
	Если Ответ.КодСостояния <> 200 Тогда
		ОбщегоНазначения.СообщитьПользователю("Сервис Master AMS вернул код " + Ответ.КодСостояния + ": " + Ответ.ТекстСостояния);
		Возврат Неопределено;
	КонецЕсли;
	
	ТекстОтвета = Ответ.ПолучитьТелоКакСтроку ();
	
	Данные = ПрочитатьОтветJSON(ТекстОтвета);
	Таблица = ПреобразоватьДанныеВТаблицу(Данные);
	
	Если Таблица = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Таблица;
	
КонецФункции 

&НаСервере
Функция ПолучитьСтруктуруНастроекМАМС()

	НастройкиСервиса = ПолучитьНастройкиСервиса();
	СтруктураНастроек = ПолучитьСтруктуруНастроек();
	ЗаполнитьЗначенияСвойств(СтруктураНастроек, НастройкиСервиса);
	
	Возврат СтруктураНастроек;
	
КонецФункции

&НаСервере
Функция ПолучитьНастройкиСервиса()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	НастройкиДляСервисов.Наименование КАК Наименование,
		|	НастройкиДляСервисов.СредаЗапуска КАК СредаЗапуска,
		|	НастройкиДляСервисов.Сервис КАК Сервис,
		|	НастройкиДляСервисов.АдресСайта КАК АдресСайта,
		|	НастройкиДляСервисов.API КАК API,
		|	НастройкиДляСервисов.Параметр КАК Параметр,
		|	НастройкиДляСервисов.APIKEY КАК APIKEY,
		|	НастройкиДляСервисов.Метод КАК Метод,
		|	НастройкиДляСервисов.URL КАК URL
		|ИЗ
		|	РегистрСведений.НастройкиДляСервисов КАК НастройкиДляСервисов
		|ГДЕ
		|	НастройкиДляСервисов.Наименование = &Наименование
		|	И НастройкиДляСервисов.СредаЗапуска = &СредаЗапуска";
	
	Совпадают = СтрокаСоединенияИнформационнойБазы() = Константы.AMS_ЭтоПродуктивнаяБаза.Получить();
	
	Если Совпадают Тогда
		СредаЗапуска = Перечисления.AMS_СредыЗапуска.Прод;
	Иначе
		СредаЗапуска = Перечисления.AMS_СредыЗапуска.Тест;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Наименование", "RatingsPositions");
	Запрос.УстановитьПараметр("СредаЗапуска", СредаЗапуска);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка;

КонецФункции

&НаСервере
Функция ПолучитьСтруктуруНастроек()
	
	Структура = Новый Структура();
	Структура.Вставить("Наименование");
	Структура.Вставить("СредаЗапуска");
	Структура.Вставить("Сервис");
	Структура.Вставить("АдресСайта");
	Структура.Вставить("API");
	Структура.Вставить("Параметр");
	Структура.Вставить("APIKEY");
	Структура.Вставить("Метод");
	
	Возврат Структура;
	
КонецФункции

&НаСервере
Функция ПрочитатьОтветJSON(ТекстJSON)

	Если ПустаяСтрока(ТекстJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON; 
	ЧтениеJSON.УстановитьСтроку(ТекстJSON);
	ДанныеJSON = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	
	Возврат ДанныеJSON;

КонецФункции

&НаСервере
Функция ПреобразоватьДанныеВТаблицу(Данные)
	
	Если ТипЗнч(Данные) = Тип("Массив") Тогда
		
		Таблица = СоздатьТаблицу();
		
		Для Каждого Элемент Из Данные Цикл
			НоваяСтрока							 = Таблица.Добавить();
			НоваяСтрока.Гуид					 = Элемент.ratingGuid;
			НоваяСтрока.Наименование			 = Элемент.ratingName;
			НоваяСтрока.ФилиалКонтрагента		 = Элемент.filialName;
			НоваяСтрока.ГуидКонтрагента			 = Элемент.intermediateSellerGuid;
			НоваяСтрока.НаименованиеКонтрагента	 = Элемент.intermediateSellerName;
			НоваяСтрока.ПозицияКонтрагента		 = Элемент.position;
			НоваяСтрока.КоличествоБаллов		 = Окр(Элемент.earnedPoints, 2);
			НоваяСтрока.КураторАгента			 = Элемент.curatorName;
			НоваяСтрока.ГуидКуратора			 = Элемент.curatorGuid;
		КонецЦикла;
		
	Иначе
		
		ОбщегоНазначения.СообщитьПользователю("Неожиданный формат JSON-ответа сервиса Master AMS.");
		Возврат Неопределено;
		
	КонецЕсли;
	
	Возврат Таблица;
	
КонецФункции

&НаСервере
Функция СоздатьТаблицу()
	
	ТЗВывод = Новый ТаблицаЗначений;
	ТЗВывод.Колонки.Добавить("Гуид");
	ТЗВывод.Колонки.Добавить("Наименование");
	ТЗВывод.Колонки.Добавить("ФилиалКонтрагента");
	ТЗВывод.Колонки.Добавить("ГуидКонтрагента");
	ТЗВывод.Колонки.Добавить("НаименованиеКонтрагента");
	ТЗВывод.Колонки.Добавить("ПозицияКонтрагента");
	ТЗВывод.Колонки.Добавить("КоличествоБаллов");
	ТЗВывод.Колонки.Добавить("КураторАгента");
	ТЗВывод.Колонки.Добавить("ГуидКуратора");
	
	Возврат ТЗВывод;
	
КонецФункции

#КонецОбласти

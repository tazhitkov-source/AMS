//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
				
КонецПроцедуры

// Конец СтандартныеПодсистемы.Печать

// СтандартныеПодсистемы.ПодключаемыеКоманды

// Определяет список команд создания на основании.
//
// Параметры:
//  КомандыСозданияНаОсновании - см. СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании
//  Параметры                  - см. СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании
//
Процедура ДобавитьКомандыСозданияНаОсновании(КомандыСозданияНаОсновании, Параметры) Экспорт
	
	Документы.ОтзывСогласияНаОбработкуПерсональныхДанных.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	
КонецПроцедуры

// Для использования в процедуре ДобавитьКомандыСозданияНаОсновании других модулей менеджеров объектов.
//  Добавляет в список команд создания на основании этот объект.
//
// Параметры:
//  КомандыСозданияНаОсновании - см. СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании
// 
// Возвращаемое значение:
//  СтрокаТаблицыЗначений, Неопределено - описание добавленной команды.
//
Функция ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании) Экспорт
	
	Возврат СозданиеНаОсновании.ДобавитьКомандуСозданияНаОсновании(КомандыСозданияНаОсновании, Метаданные.Документы.AMS_ИзмененияДанныхПродавцов);
	
КонецФункции

// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

#Область ПроведениеДокумента

Функция ПодготовитьПараметрыПроведения(ДокументСсылка, Отказ) Экспорт
	
	ПараметрыПроведения = Новый Структура;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаТаблицыДокумента();
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	AMS_ОбщиеПравилаРасчетаДополнительногоКВ = Запрос.Выполнить().Выгрузить();	
	
	СтруктураТаблицДокумента = Новый Структура;
	СтруктураТаблицДокумента.Вставить("AMS_ОбщиеПравилаРасчетаДополнительногоКВ", AMS_ОбщиеПравилаРасчетаДополнительногоКВ);
	
	ПараметрыПроведения.Вставить("СтруктураТаблицДокумента", СтруктураТаблицДокумента);
	
	Возврат ПараметрыПроведения;
	
КонецФункции	

Функция ТекстЗапросаТаблицыДокумента()
	
	Результат = 
	"ВЫБРАТЬ
	|	AMS_ИзменениеДополнительногоКВОбщееСтраховыеПродукты.СтраховойПродукт КАК СтраховойПродукт,
	|	AMS_ИзменениеДополнительногоКВОбщееСтраховыеПродукты.Ссылка КАК Ссылка,
	|	AMS_ИзменениеДополнительногоКВОбщееСтраховыеПродукты.Ссылка.Дата КАК Дата,
	|	AMS_ИзменениеДополнительногоКВОбщееСтраховыеПродукты.Процент КАК Процент,
	|	AMS_ИзменениеДополнительногоКВОбщееСтраховыеПродукты.Отменен КАК Отменен,
	|	AMS_ИзменениеДополнительногоКВОбщееСтраховыеПродукты.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
	|	AMS_ИзменениеДополнительногоКВОбщееПоказатели.КлючУсловий КАК КлючУсловий,
	|	AMS_ИзменениеДополнительногоКВОбщееСтраховыеПродукты.КлючСвязи КАК ГУИД,
	|	AMS_ИзменениеДополнительногоКВОбщееСтраховыеПродукты.СтраховойРиск КАК СтраховойРиск,
	|	AMS_ИзменениеДополнительногоКВОбщееСтраховыеПродукты.ДатаНачалаДействия КАК ДатаНачалаДействия
	|ПОМЕСТИТЬ ВТ_ДанныеПоСтраховымПродуктам
	|ИЗ
	|	Документ.AMS_ИзменениеДополнительногоКВОбщее.СтраховыеПродукты КАК AMS_ИзменениеДополнительногоКВОбщееСтраховыеПродукты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.AMS_ИзменениеДополнительногоКВОбщее.Показатели КАК AMS_ИзменениеДополнительногоКВОбщееПоказатели
	|		ПО AMS_ИзменениеДополнительногоКВОбщееСтраховыеПродукты.КлючСвязи = AMS_ИзменениеДополнительногоКВОбщееПоказатели.КлючСвязи
	|ГДЕ
	|	AMS_ИзменениеДополнительногоКВОбщееПоказатели.Ссылка = &Ссылка
	|	И AMS_ИзменениеДополнительногоКВОбщееСтраховыеПродукты.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	AMS_ИзменениеДополнительногоКВОбщее.Филиал КАК Филиал,
	|	AMS_ИзменениеДополнительногоКВОбщее.КаналПродаж КАК КаналПродаж,
	|	AMS_ИзменениеДополнительногоКВОбщее.ПодканалПродаж КАК ПодканалПродаж,
	|	AMS_ИзменениеДополнительногоКВОбщее.КатегорияПродавца КАК КатегорияПродавца,
	|	ВТ_ДанныеПоСтраховымПродуктам.Дата КАК Период,
	|	ВТ_ДанныеПоСтраховымПродуктам.СтраховойПродукт КАК СтраховойПродукт,
	|	ВТ_ДанныеПоСтраховымПродуктам.Процент КАК Процент,
	|	ВТ_ДанныеПоСтраховымПродуктам.Отменен КАК Отменен,
	|	ВТ_ДанныеПоСтраховымПродуктам.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
	|	ВТ_ДанныеПоСтраховымПродуктам.СтраховойРиск КАК СтраховойРиск,
	|	ВТ_ДанныеПоСтраховымПродуктам.КлючУсловий КАК КлючУсловий,
	|	ВТ_ДанныеПоСтраховымПродуктам.ГУИД КАК ГУИД,
	|	ВТ_ДанныеПоСтраховымПродуктам.ДатаНачалаДействия КАК ДатаНачалаДействия
	|ИЗ
	|	ВТ_ДанныеПоСтраховымПродуктам КАК ВТ_ДанныеПоСтраховымПродуктам
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.AMS_ИзменениеДополнительногоКВОбщее КАК AMS_ИзменениеДополнительногоКВОбщее
	|		ПО ВТ_ДанныеПоСтраховымПродуктам.Ссылка = AMS_ИзменениеДополнительногоКВОбщее.Ссылка";
	
	Возврат Результат;
	
КонецФункции	

#КонецОбласти

#Область ЗагрузкаСЦССУ

Процедура СформироватьИзменитьЭлементСправочника(ОписаниеОбъектов) Экспорт
	
	Если ОписаниеОбъектов.Количество() = 0 Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ТаблицаОбъекта = AMS_КомиссионноеВознаграждение.ПреобразоватьСообщениеЦССУВТаблицуЗначений(ОписаниеОбъектов);

	Если ТаблицаОбъекта.Количество() = 0 Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ТаблицаАгентов = ТаблицаОбъекта.Скопировать(, "Агент"); 
	ТаблицаАгентов.Свернуть("Агент");
	
	ЭтоИндивидуальноеКВ = Ложь;
	
	Если ТаблицаАгентов.Количество() >= 1 Тогда
		
		Агент = ЭлементСправочникаПоЦССУ("AMS_Агенты", ТаблицаАгентов[0].Агент);
		Если ЗначениеЗаполнено(Агент) Тогда
			ЭтоИндивидуальноеКВ = Истина;
		КонецЕсли;
		
	КонецЕсли;	 
	
	Если ЭтоИндивидуальноеКВ Тогда
		
		СоздатьДокументИндивидуальногоКВ(ТаблицаОбъекта);
		
	Иначе
		
		СоздатьДокументОбщегоКВ(ТаблицаОбъекта);
		
	КонецЕсли;	
	
КонецПроцедуры	

Процедура СоздатьДокументИндивидуальногоКВ(ТаблицаОбъекта)

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаИндивидуальноеКВ();	
	Запрос.УстановитьПараметр("ВходящиеДанные", ТаблицаОбъекта);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаАгент = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаАгент.Следующий() Цикл
		
		 Агент = ЭлементСправочникаПоЦССУ("AMS_Агенты", ВыборкаАгент.Агент);
		 ДокументОбъект = Документы.AMS_ИзменениеДополнительногоКВИндивидуальное.СоздатьДокумент();
		 ДокументОбъект.Дата = ?(ЗначениеЗаполнено(ВыборкаАгент.Дата), ВыборкаАгент.Дата, ТекущаяДатаСеанса());
		 ДокументОбъект.ГУИДЦССУ = ВыборкаАгент.ГУИД;
		 ДокументОбъект.Агент    = Агент;
		 ДокументОбъект.Организация = Константы.AMS_ОрганизацияПоУмолчанию.Получить();
		 ДокументОбъект.ЭтоКВБанка  = ВыборкаАгент.ЭтоБанк;
		 
		 ВыборкаСтраховойПродукт = ВыборкаАгент.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		 
		 ЗаполнитьДокументКВ(ВыборкаСтраховойПродукт, ДокументОбъект);
		 Попытка
			 ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		 Исключение
			 ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		 КонецПопытки;	 
	КонецЦикла;	
	
КонецПроцедуры

Процедура СоздатьДокументОбщегоКВ(ТаблицаОбъекта)

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаОбщееКВ();	
	Запрос.УстановитьПараметр("ВходящиеДанные", ТаблицаОбъекта);
	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаФилиал = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

	Пока ВыборкаФилиал.Следующий() Цикл
		Филиал = ЭлементСправочникаПоЦССУ("AMS_Филиалы", ВыборкаФилиал.Филиал);

		ВыборкаКаналПродаж = ВыборкаФилиал.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаКаналПродаж.Следующий() Цикл

			КаналПродаж = Справочники.AMS_КаналыПродаж.НайтиПоРеквизиту("ГУИДЦССУ", ВыборкаКаналПродаж.КаналПродаж);

			ВыборкаПодканал = ВыборкаКаналПродаж.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

			Пока ВыборкаПодканал.Следующий() Цикл

				ПодканалПродаж = Справочники.AMS_КаналыПродаж.НайтиПоРеквизиту("ГУИДЦССУ", ВыборкаПодканал.ПодканалПродаж);

				ВыборкаКатегория = ВыборкаПодканал.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

				Пока ВыборкаКатегория.Следующий() Цикл

					Категория = ЭлементСправочникаПоЦССУ("AMS_КатегорииПродавца", ВыборкаКатегория.КатегорияПродавца);

					ДокументОбъект = Документы.AMS_ИзменениеДополнительногоКВОбщее.СоздатьДокумент();
					ДокументОбъект.Дата = ?(ЗначениеЗаполнено(ВыборкаФилиал.Дата), ВыборкаФилиал.Дата, ТекущаяДатаСеанса());
					ДокументОбъект.ГУИДЦССУ = ВыборкаФилиал.ГУИД;
					ДокументОбъект.Филиал    			= Филиал;
					ДокументОбъект.КаналПродаж   		= КаналПродаж;
					ДокументОбъект.ПодканалПродаж    	= ПодканалПродаж;
					ДокументОбъект.КатегорияПродавца    = Категория;

					ДокументОбъект.Организация = Константы.AMS_ОрганизацияПоУмолчанию.Получить();

					ВыборкаСтраховойПродукт = ВыборкаКатегория.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

					ЗаполнитьДокументКВ(ВыборкаСтраховойПродукт, ДокументОбъект);
					Попытка
						ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
					Исключение
						ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
					КонецПопытки;

				КонецЦикла; 

			КонецЦикла;	 

		КонецЦикла;

	КонецЦикла;
	
КонецПроцедуры	

Процедура ЗаполнитьДокументКВ(ВыборкаСтраховойПродукт, ДокументОбъект)

	Пока ВыборкаСтраховойПродукт.Следующий() Цикл
		
		ВыборкаПроцент = ВыборкаСтраховойПродукт.Выбрать();
		
		Пока ВыборкаПроцент.Следующий() Цикл
			
			Если ВыборкаПроцент.Процент = 0 Тогда
				
				Продолжить;
				
			КонецЕсли;	
			
			ИдентификаторСтроки = XMLСтрока(Новый УникальныйИдентификатор);
			
			// Страховой продукт
			СтрокаСП = ДокументОбъект.СтраховыеПродукты.Добавить();
			СтрокаСП.СтраховойПродукт = ЭлементСправочникаПоЦССУ("AMS_СтраховыеПродукты", ВыборкаПроцент.СтраховойПродукт);
			СтрокаСП.КлючСвязи = ИдентификаторСтроки;
			
						
			СтрокаСП.Процент = ВыборкаПроцент.Процент;
			СтрокаСП.ДатаОкончанияДействия = ВыборкаПроцент.ДатаОкончанияДействия;
			СтрокаСП.ДатаНачалаДействия    = ДокументОбъект.Дата;
			//Условия
			МассивУсловий = Новый Массив;
			ОбработатьУсловие(МассивУсловий, ВыборкаПроцент, "КБМОт", ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.КБМ, "Число"); 
			ОбработатьУсловие(МассивУсловий, ВыборкаПроцент, "ПремияОт", ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.Премия, "Число");
			ОбработатьУсловие(МассивУсловий, ВыборкаПроцент, "ГодСтрахования", ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.ГодСтрахования, "Число");
			ОбработатьУсловие(МассивУсловий, ВыборкаПроцент, "КатегорияДоговора", ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.КатегорияДоговора, "AMS_КатегорииДоговоров");
			// ОбработатьУсловие(МассивУсловий, ВыборкаПроцент, "СтраховойПродукт", ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.СтраховойПродукт, "AMS_СтраховыеПродукты");
			ОбработатьУсловие(МассивУсловий, ВыборкаПроцент, "СтраховойРиск", ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.СтраховойРиск, "AMS_СтраховыеРиски");
			ОбработатьУсловие(МассивУсловий, ВыборкаПроцент, "ЭтоЭлектронноеОсаго", ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.ЭтоЕОСАГО, "Булево");
			
			Если ЗначениеЗаполнено(ВыборкаПроцент.БанкИНН)
				И ВыборкаПроцент.БанкИНН <> "00000000-0000-0000-0000-000000000000" Тогда
				
				НовоеУсловие = AMS_КлючиУсловийСервер.Условие();
				НовоеУсловие.Параметр = ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.Банк;
				НовоеУсловие.Значение = ВыборкаПроцент.БанкИНН;
				МассивУсловий.Добавить(НовоеУсловие);
				
			КонецЕсли;	
			
			КлючУсловий = AMS_КлючиУсловийСервер.ЭлементКлючаУсловий(МассивУсловий);
			
			СтрокаУсловий = ДокументОбъект.Показатели.Добавить();
			СтрокаУсловий.КлючСвязи = ИдентификаторСтроки;
			СтрокаУсловий.КлючУсловий = КлючУсловий;
			
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры

Процедура ОбработатьУсловие(МассивУсловий, ВыборкаДетали, Реквизит, Характеристика, Тип)
	
	Элемент = ВыборкаДетали[Реквизит]; 
	ЭлементСсылка = ЭлементСправочникаПоЦССУ(Тип, Элемент);
	
	Если ТипЗнч(ЭлементСсылка) = Тип("Булево") 
		И НЕ ЭлементСсылка Тогда
		Возврат;
		
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ЭлементСсылка) Тогда
			
			НовоеУсловие = AMS_КлючиУсловийСервер.Условие();
			НовоеУсловие.Параметр = Характеристика;
			НовоеУсловие.Значение = ЭлементСсылка;
			МассивУсловий.Добавить(НовоеУсловие);
			
	КонецЕсли;
		
КонецПроцедуры	


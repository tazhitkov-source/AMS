		|	Регистратор";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаРегистратор = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаРегистратор.Следующий() Цикл
	
		ВыборкаДетальныеЗаписи = ВыборкаРегистратор.Выбрать();
		
		Набор = РегистрыСведений.AMS_ИндивидуальныеПравилаРасчетаДополнительногоКВ.СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(ВыборкаРегистратор.Регистратор);
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			ЗаписьНабора = Набор.Добавить();
			ЗаполнитьЗначенияСвойств(ЗаписьНабора, ВыборкаДетальныеЗаписи);
			ЗаписьНабора.ГУИД = Строка(Новый УникальныйИдентификатор);
			
		КонецЦикла;
		Набор.ОбменДанными.Загрузка = Истина;
		Набор.Записать(Истина);
		
	КонецЦикла;
		
КонецПроцедуры	


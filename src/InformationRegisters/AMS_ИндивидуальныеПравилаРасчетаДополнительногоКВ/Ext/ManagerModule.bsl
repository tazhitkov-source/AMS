	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	AMS_ИндивидуальныеПравилаРасчетаДополнительногоКВ.Период КАК Период,
		|	AMS_ИндивидуальныеПравилаРасчетаДополнительногоКВ.Регистратор КАК Регистратор,
		|	AMS_ИндивидуальныеПравилаРасчетаДополнительногоКВ.НомерСтроки КАК НомерСтроки,
		|	AMS_ИндивидуальныеПравилаРасчетаДополнительногоКВ.Активность КАК Активность,
		|	AMS_ИндивидуальныеПравилаРасчетаДополнительногоКВ.Организация КАК Организация,
		|	AMS_ИндивидуальныеПравилаРасчетаДополнительногоКВ.Филиал КАК Филиал,

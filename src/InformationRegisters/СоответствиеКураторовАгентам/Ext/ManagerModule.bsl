Процедура ЗаписатьСоответствие(Агент, Куратор) Экспорт
	
	Менеджер = РегистрыСведений.СоответствиеКураторовАгентам.СоздатьМенеджерЗаписи();
	Менеджер.Куратор = Куратор;
	Менеджер.Агент   = Агент;
	Менеджер.Записать(Истина);
	
КонецПроцедуры	

#Область ИнтеграцияСМАМС

Функция СформироватьСообщениеДляМАМС(Куратор, Агент) Экспорт
	
	 Результат = ПолучитьСтруктуруСообщения();
	 ЗаполнитьСтруктуруСообщенияМАМС(Куратор, Агент, Результат);	 	 
	 Данные = ОбменДаннымиAMS.СформироватьСтрокуJSON(Результат, ВариантЗаписиДатыJSON.ЛокальнаяДатаСоСмещением);	 
	 
	 Возврат Данные;
	 
 КонецФункции
 

Процедура СоздатьИнформациюОИБ(ОписаниеБД, СредаЗапуска) Экспорт 
	
	МенеджерЗаписи = РегистрыСведений.AMS_ИнформацияОИБ.СоздатьМенеджерЗаписи();
	
	МенеджерЗаписи.ИмяСервера = ОписаниеБД.ИмяСервера;
	МенеджерЗаписи.ИмяБазы = ОписаниеБД.ИмяБазы;
	МенеджерЗаписи.СредаЗапуска = СредаЗапуска;
	
	МенеджерЗаписи.Записать();
	

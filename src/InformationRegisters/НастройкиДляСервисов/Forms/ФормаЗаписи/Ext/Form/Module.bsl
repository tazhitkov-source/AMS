#Область ОбработчикиСобытий

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Запись.URL = "";
КонецПроцедуры

#КонецОбласти

#Область Команды

&НаКлиенте
Процедура Проверить(Команда)
	URL = Запись.АдресСайта + СтрШаблон(Запись.API, Запись.Параметр);
	Запись.URL = СтрЗаменить(URL, "//", "/");
КонецПроцедуры

#КонецОбласти

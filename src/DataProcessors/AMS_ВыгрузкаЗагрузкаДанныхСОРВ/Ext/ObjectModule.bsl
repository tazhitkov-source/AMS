Функция ПолучитьЗначение(Значение, ВидСравнения)
	
	Если ВидСравнения <> Справочники.AMS_ВидыСравнения.ВСписке
		И ВидСравнения <> Справочники.AMS_ВидыСравнения.НеВСписке Тогда
		
		Возврат AMS_ИнтеграцияМАМССервер.СериализоватьЗначение(Значение.Значение);
		
	КонецЕсли;
	
	СписокЗначений = Значение.ЗначениеПроизвольногоТипа.Получить();
	Результат = "";
	

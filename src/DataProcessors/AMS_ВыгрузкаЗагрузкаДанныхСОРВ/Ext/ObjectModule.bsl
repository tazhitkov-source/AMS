Процедура ПолучитьНеобходимыеРеквизитыЭлемента_AMS_ПараметрыДополнительныхУсловий(ПараметрыЭлемента, Элемент, СоответствиеТипов)
	
	РеквизитыЭлемента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Элемент.Ссылка, "ГУИД, Наименование, ПометкаУдаления, ПутьКДанным, ТипЗначения");
	ТипПараметра = ОпределитьТипПараметра(РеквизитыЭлемента.ТипЗначения);
	
	ПараметрыЭлемента.Вставить("id"				, РеквизитыЭлемента.ГУИД);
	ПараметрыЭлемента.Вставить("AdditionalID"	, "");
	ПараметрыЭлемента.Вставить("Name"			, РеквизитыЭлемента.Наименование);
	ПараметрыЭлемента.Вставить("FullName"		, РеквизитыЭлемента.Наименование);
	ПараметрыЭлемента.Вставить("Disabled"		, РеквизитыЭлемента.ПометкаУдаления);
	ПараметрыЭлемента.Вставить("Path"			, РеквизитыЭлемента.ПутьКДанным);
	ПараметрыЭлемента.Вставить("DataTypeId"		, СоответствиеТипов[ТипПараметра]);
	

#Область ПрограммныйИнтерфейс

//Входная точка для нетиповых обменов в подсистеме "Обмен данными" БСП
Процедура ВыгрузкаЗагрузкаДанных(СтандартнаяОбработка,
								ПланОбмена,
								ИмяФайлаСообщения,
								ДанныеСообщения,
								КоличествоЭлементовВТранзакции,
								ИмяСобытияЖурналаРегистрации,
								КоличествоОтправленныхОбъектов,
								НаименованиеПланаОбмена,
								ВидПроцедуры,
								Отладка = Ложь,
								ОтладочноеСообщение = Неопределено) Экспорт
								
	СтандартнаяОбработка = Ложь;
	
	ВыполнитьВыгрузкуЗагрузкуИзмененийДляУзлаСОРВ(ПланОбмена, ИмяФайлаСообщения, ДанныеСообщения,КоличествоЭлементовВТранзакции,
						ИмяСобытияЖурналаРегистрации, КоличествоОтправленныхОбъектов, ВидПроцедуры, Отладка, ОтладочноеСообщение);
	
КонецПроцедуры

#КонецОбласти

#Область ВариантыОбмена

Процедура ВыполнитьВыгрузкуЗагрузкуИзмененийДляУзлаСОРВ(УзелИнформационнойБазы, ИмяФайла, СообщениеОбмена,
														   КоличествоЭлементовВТранзакции = 0, КлючСообщенияЖурналаРегистрации = "",
														   КоличествоОбъектовОбработано = 0, ВидПроцедуры, Отладка, ОтладочноеСообщение)
							
	Если ВидПроцедуры = "Выгрузка" Тогда
		ВыполнитьВыгрузкуИзмененийДляУзлаСОРВ(УзелИнформационнойБазы, ИмяФайла, СообщениеОбмена,
							КоличествоЭлементовВТранзакции, КлючСообщенияЖурналаРегистрации, КоличествоОбъектовОбработано, ВидПроцедуры);
	Иначе
		//ВыполнитьЗагрузкуИзмененийДляУзлаМонолит(УзелИнформационнойБазы, ИмяФайла, СообщениеОбмена,
		//					КоличествоЭлементовВТранзакции, КлючСообщенияЖурналаРегистрации, КоличествоОбъектовОбработано, ВидПроцедуры);					
	КонецЕсли;	
	
КонецПроцедуры

Процедура ВыполнитьВыгрузкуИзмененийДляУзлаСОРВ(УзелИнформационнойБазы, ИмяФайла, СообщениеОбмена,
							КоличествоЭлементовВТранзакции, КлючСообщенияЖурналаРегистрации, КоличествоОбъектовОбработано, ВидПроцедуры)

	ОбработаноСообщений			= 0;
	ПереданоСОшибкой			= 0;
	ЗарегистрированныеОбъекты	= ПолучитьЗарегистрированныеКОтправкеОбъекты(ИмяФайла, УзелИнформационнойБазы);
	ОбъектыОбработанныеСОшибкой	= Новый Массив();
	СтруктураСообщения			= ПолучитьСтруктуруСообщения();
	ИменаПолейВСообщении		= ПолучитьСоответствиеПолейСообщения();
	ГУИДыВидовСравнения			= ПолучитьСоответствиеГУИДыВидовСравнения();
	СоответствиеТипов			= ПолучитьСоответствиеТиповСОРВ();
	
	РезультатОтправки = Новый Структура("Успех, Сообщение", Истина, Неопределено);
	
	Для Каждого Пакет Из ЗарегистрированныеОбъекты Цикл
		
		ВыборкаИзменений = Пакет.Выбрать();
		
		Пока ВыборкаИзменений.Следующий() Цикл
			
			СтруктураСообщения			= ПолучитьСтруктуруСообщения();
			ДобавитьТекущийЭлементВСтруктуруСообщения(ВыборкаИзменений, СтруктураСообщения, ИменаПолейВСообщении, ГУИДыВидовСравнения,
														СоответствиеТипов);
			ТекстСообщения = СформироватьТекстСообщения(СтруктураСообщения);
			
			ЗаписьЖурналаРегистрации("СОРВ.СообщенияИнтеграции." + ВыборкаИзменений.Тип, УровеньЖурналаРегистрации.Предупреждение,,, ТекстСообщения);
			
			РезультатОтправки = ОтправитьСообщениеВСОРВ(ТекстСообщения, УзелИнформационнойБазы);											
			
		КонецЦикла;
		
	КонецЦикла; 
		
	Если РезультатОтправки.Успех Тогда
		
		ОбработаноСообщений = ОбработаноСообщений + 1;
		ОчиститьСписокИзменений(УзелИнформационнойБазы);
		СоздатьФайлВыгрузкиЗаглушкуДляОбменаНаБСП(ИмяФайла);
		
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Обмен данными.СОРВ.Отправка данных"
			, УровеньЖурналаРегистрации.Информация, Метаданные.ПланыОбмена.СОРВ, "", "Выгрузка проведена успешно");
		
	Иначе
		ПереданоСОшибкой = ПереданоСОшибкой + 1;
		ТекстЗаписиЖурнала = "Данное сообщение не обработано:
							|" + РезультатОтправки.Сообщение;
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Обмен данными.СОРВ.Отправка данных"
			, УровеньЖурналаРегистрации.Ошибка, Метаданные.ПланыОбмена.СОРВ, "", ТекстЗаписиЖурнала);

	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область СформироватьСообщение

//Чтобы типовой механизм понял, что выгрузка данных произошла,
//надо заполнить типовой файл выгрузки содержимым.
Процедура СоздатьФайлВыгрузкиЗаглушкуДляОбменаНаБСП(ИмяФайлаСообщения)

	ЗаписьХМЛ = Новый ЗаписьXML;
	ЗаписьХМЛ.ОткрытьФайл(ИмяФайлаСообщения);
	ТекстЗаглушка = "Этот файл создаётся типовым механизмом обмена БСП. Его следует игнорировать. Можно удалять.";
	ЗаписьХМЛ.ЗаписатьНачалоЭлемента("Данные");
	ЗаписьХМЛ.ЗаписатьТекст(ТекстЗаглушка);
	ЗаписьХМЛ.ЗаписатьКонецЭлемента();
	ЗаписьХМЛ.Закрыть();
	
КонецПроцедуры

//Получение зарегистрированных изменений объектов
Функция ПолучитьЗарегистрированныеКОтправкеОбъекты(ИмяФайла, УзелИнформационнойБазы)

	МетаДанныеОбмена		= УзелИнформационнойБазы.МетаДанные();
	СоставПланаОбмена		= МетаДанныеОбмена.Состав;
	УчаствуютВОбмене		= Новый Массив();
	НаименованиеПланаОбмена = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УзелИнформационнойБазы, "Наименование");
	
	Для Каждого Элемент Из СоставПланаОбмена Цикл
		УчаствуютВОбмене.Добавить(Элемент.Метаданные.ПолноеИмя());
	КонецЦикла;
	
	// Получаем выборку измененных данных.
	Запрос = Новый Запрос;
	Запрос.Текст = ОбменДаннымиAMS.ТекстЗапросаИзмененийПланаОбмена(УчаствуютВОбмене, НаименованиеПланаОбмена);
	Запрос.УстановитьПараметр("Узел", УзелИнформационнойБазы);
	
	ВыборкаИзменений = Запрос.ВыполнитьПакет();
	
	Возврат ВыборкаИзменений;
	
КонецФункции

//Текстовое представление реквизитов отправляемых данных
Функция СписокРеквизитовОбъекта(Данные)

	Результат = "";
	МетаданныеОбъекта = Данные.Метаданные();
	
	Для Каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
		ИмяРеквизита = Реквизит.Имя; 
		Результат 	 = Результат + ИмяРеквизита + ", ";
	КонецЦикла;
	
	СтроковыеФункцииКлиентСервер.УдалитьПоследнийСимволВСтроке(Результат, 2);
	
	Возврат Результат;
	
КонецФункции

//Формирует структуру отправляемого сообщения
Функция ПолучитьСтруктуруСообщения()

	Результат = Новый Структура();
	
	Результат.Вставить("systems"						, Новый Массив());
	Результат.Вставить("sellerOptions"					, Новый Массив());
	Результат.Вставить("remunerationKinds"				, Новый Массив());
	Результат.Вставить("products"						, Новый Массив());
	Результат.Вставить("remunerationConstraints"		, Новый Массив());
	Результат.Вставить("additionalConditionParameters"	, Новый Массив());
	Результат.Вставить("additionalConditionSets"		, Новый Массив());
	Результат.Вставить("calculationRules"				, Новый Массив());
	Результат.Вставить("bonusProgramRules"				, Новый Массив());
	Результат.Вставить("Banks"							, Новый Массив());
	Результат.Вставить("BankAgentMaxKVS"				, Новый Массив());
	
	Возврат Результат;
	
КонецФункции


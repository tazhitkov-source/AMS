Функция ОтправитьСообщениеВСОРВ(ТекстСообщения, Узел)
	
	Результат = Новый Структура("Успех, Сообщение", Ложь, ТекстСообщения);
	
	ПараметрыПодключения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Узел, "Адрес, Токен, Запрос, ТипЗапроса");

	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
	Соединение = Новый HTTPСоединение(ПараметрыПодключения.Адрес,,,,,30, ЗащищенноеСоединение);
	
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	
	СтрокаЗапроса = ПараметрыПодключения.Запрос + "?api-key=" + ПараметрыПодключения.Токен;
	Запрос = Новый HTTPЗапрос(СтрокаЗапроса, Заголовки);
	Запрос.УстановитьТелоИзСтроки(ТекстСообщения);
	
	Попытка
		Ответ = Соединение.ВызватьHTTPМетод(ПараметрыПодключения.ТипЗапроса, Запрос);
	Исключение
		
		ЗаписьЖурналаРегистрации("СОРВ.ОбменДанными", УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки());
		ЗаписьЖурналаРегистрации("СОРВ.ОбменДанными.Сообщения", УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
		
		Возврат Результат;
		
	КонецПопытки;
	
	Результат.Успех = Истина;
	
	Возврат Результат;
	
КонецФункции


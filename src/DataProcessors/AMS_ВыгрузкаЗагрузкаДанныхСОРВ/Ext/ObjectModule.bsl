#Область МотивационныеПрограммы

Процедура ПолучитьНеобходимыеРеквизитыЭлемента_AMS_ИзменениеУсловийМотивационнойПрограммы(МассивСообщений, 
																					Элемент, ГУИДыВидовСравнения);
																					
	ПрограммаОбъект = Элемент.Ссылка;																					
	Данные = ЗапросПравилИзмененияМП(ПрограммаОбъект);																				
	СформироватьПакетПравилМП(МассивСообщений, Данные);																				

КонецПроцедуры

Процедура СформироватьПакетПравилМП(МассивСообщений, Данные)
	
	ПМИсключение = Константы.AMS_МТСистемаЛояльности.Получить();
	
	Для каждого Правило Из Данные Цикл
		
		Если ПМИсключение = Правило.МотивационнаяПрограмма Тогда
			
			Продолжить;
			
		КонецЕсли;	
	
		ДополнитьПравиломМП(МассивСообщений, Правило);
	
	КонецЦикла;	
	
КонецПроцедуры	

Процедура ДополнитьПравиломМП(МассивПравил, Правило)
	
	СтруктураПравила = ИнициализироватьСтруктуруПравилаМП();
	СтруктураПравила.id                 = AMS_ИнтеграцияМАМССервер.ПобитовоеXORСтрок(Правило.ИдентификаторПравила, Правило.Агент);
	СтруктураПравила.programGuid		= Правило.МотивационнаяПрограмма.ГУИД;
	СтруктураПравила.additionalId       = Правило.ИдентификаторПравила;
	СтруктураПравила.name		        = Правило.МотивационнаяПрограмма.Наименование;
	СтруктураПравила.fullName 			= Правило.МотивационнаяПрограмма.Наименование;
	СтруктураПравила.startDate 			= Правило.ДатаНачалаДействия;
	СтруктураПравила.percent 			= Правило.Процент;
	СтруктураПравила.disabled 			= Правило.Отменен;
	СтруктураПравила.partner 			= Правило.Агент;
	
	Если ЗначениеЗаполнено(Правило.ДатаОкончанияДействия) Тогда
		СтруктураПравила.endDate = КонецДня(Правило.ДатаОкончанияДействия);
	ИначеЕсли ЗначениеЗаполнено(Правило.ДатаИсключения) Тогда
		СтруктураПравила.endDate = КонецДня(Правило.ДатаИсключения);
	Иначе
		СтруктураПравила.endDate = null;
	КонецЕсли;
	
	Если Правило.КлючУсловий.НаборУсловий.Количество() > 0 Тогда
		
		ЗаполнитьМППоУсловиям(СтруктураПравила, Правило.КлючУсловий.НаборУсловий);
		
	КонецЕсли;	
	
	Если Правило.КлючУсловий.НаборКлючей.Количество() > 0 Тогда
		
		Для каждого Ключ Из Правило.КлючУсловий.НаборКлючей Цикл
		
			КлючУсловий = Ключ.КлючУсловий;
			ОсновнойКлюч   = Ключ.ОсновнойКлюч;
			
			Если ОсновнойКлюч Тогда
				
				ЗаполнитьМППоУсловиям(СтруктураПравила, КлючУсловий.НаборУсловий);
				
			Иначе
				
				ЗаполнитьКраткоеУсловиеМП(СтруктураПравила, КлючУсловий.НаборУсловий, КлючУсловий.ИмяПеременной);
				
			КонецЕсли;	
		
		КонецЦикла;
		
	КонецЕсли;	
	
	МассивПравил.Добавить(СтруктураПравила);
	
КонецПроцедуры	

Процедура ЗаполнитьМППоУсловиям(СтруктураПравила, НаборУсловий) 

	Для каждого Условие  Из НаборУсловий Цикл
		
		// delete
		Если Условие.Параметр = ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.ДебиторскаяЗадолженность Тогда
			
			Продолжить;
			
		КонецЕсли;	
		// delete end		
		
		СтруктураСтрокиУсловий = ИнициализироватьСтрокуУсловийКВ();
		СтруктураСтрокиУсловий.Value = ПолучитьЗначение(Условие, Условие.ОператорСравнения);
		
		СтруктураСтрокиУсловий.Path = Условие.Параметр.ПутьКДанным;
		СтруктураСтрокиУсловий.dataTypeId = AMS_ИнтеграцияМАМССервер.СериализоватьЗначение(Условие.Параметр.ТипДанныхСОРВ);
		СтруктураСтрокиУсловий.ConditionKindId = AMS_ИнтеграцияМАМССервер.СериализоватьЗначение(Условие.ОператорСравнения);
		
		СтруктураПравила.AdditionalConditions.Добавить(СтруктураСтрокиУсловий);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьКраткоеУсловиеМП(СтруктураПравила, НаборУсловий, Переменная) 

	Для каждого Условие  Из НаборУсловий Цикл
		
		Если Условие.Параметр <> ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.Премия Тогда
			
			Продолжить;
			
		КонецЕсли;	
		
		// delete
		Если Условие.Параметр = ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.ДебиторскаяЗадолженность Тогда
			
			Продолжить;
			
		КонецЕсли;	
		// delete end
		
		СтруктураСтрокиУсловий = ИнициализироватьСтрокуУсловийКВ();
	   	СтруктураСтрокиУсловий.Value = ПолучитьЗначение(Условие, Условие.ОператорСравнения);
		СтруктураСтрокиУсловий.Path = Переменная;
		СтруктураСтрокиУсловий.dataTypeId 		= AMS_ИнтеграцияМАМССервер.СериализоватьЗначение(Условие.Параметр.ТипДанныхСОРВ);
		СтруктураСтрокиУсловий.ConditionKindId  = AMS_ИнтеграцияМАМССервер.СериализоватьЗначение(Условие.ОператорСравнения);
		
		СтруктураПравила.AdditionalConditions.Добавить(СтруктураСтрокиУсловий);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ИнициализироватьСтруктуруПравилаМП()
	
	 Результат = Новый Структура();
	 Результат.Вставить("id");
	 Результат.Вставить("programGuid");
	 Результат.Вставить("additionalId");
	 Результат.Вставить("name");
	 Результат.Вставить("disabled");

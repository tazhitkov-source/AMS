#Область ПолучениеДанныхОбъектовВыгрузки

Процедура ПолучитьНеобходимыеРеквизитыЭлемента_AMS_Продавцы(ПараметрыЭлемента, Элемент)
		
	РеквизитыЭлемента = Справочники.AMS_Продавцы.ДанныеПродавцаПоСсылке(Элемент.Ссылка);
	
	Если ЗначениеЗаполнено(РеквизитыЭлемента.ГУИД) Тогда
		
		ПараметрыЭлемента.Вставить("Id"							, XMLСтрока(РеквизитыЭлемента.ГУИД));
		ПараметрыЭлемента.Вставить("PartnerId"					, XMLСтрока(РеквизитыЭлемента.АгентГУИД));
		ПараметрыЭлемента.Вставить("PartnerType"				, XMLСтрока(Строка(РеквизитыЭлемента.ТипАгента)));
		ПараметрыЭлемента.Вставить("firstLevelFilialId		"	, XMLСтрока(РеквизитыЭлемента.ФилиалГУИД));
		ПараметрыЭлемента.Вставить("secondLevelFilialId		"	, "");
		ПараметрыЭлемента.Вставить("SaleChannelId"				, XMLСтрока(РеквизитыЭлемента.КаналПродажГУИД));
		ПараметрыЭлемента.Вставить("SaleSubchannelId"			, XMLСтрока(РеквизитыЭлемента.ПодканалПродажГУИД));
		ПараметрыЭлемента.Вставить("Disabled"					, XMLСтрока(РеквизитыЭлемента.Уволен));
		ПараметрыЭлемента.Вставить("SellerCategory"				, XMLСтрока(РеквизитыЭлемента.КатегорияАгента));
		
	КонецЕсли;

КонецПроцедуры

Процедура ПолучитьНеобходимыеРеквизитыЭлемента_AMS_Системы(ПараметрыЭлемента, Элемент)
	
	//Сделать через переменную ГУИД, Код, Наименование, ПолноеНаименование, ПометкаУдаления,
	//| Отключен, СОРВКлючДляApi, СОРВРасчетВознаграждений, СОРВПолучениеПравилРасчета, СОРВАдминистрирование
	
	РеквизитыЭлемента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Элемент.Ссылка, "ГУИД, Код, Наименование, ПолноеНаименование, ПометкаУдаления,
	| Отключен, СОРВКлючДляApi, СОРВРасчетВознаграждений, СОРВПолучениеПравилРасчета, СОРВАдминистрирование");
	
	ПараметрыЭлемента.Вставить("Id"							, РеквизитыЭлемента.ГУИД);
	ПараметрыЭлемента.Вставить("AdditionalId"				, РеквизитыЭлемента.Код);
	ПараметрыЭлемента.Вставить("Name"						, РеквизитыЭлемента.Наименование);
	ПараметрыЭлемента.Вставить("FullName"					, РеквизитыЭлемента.ПолноеНаименование);
	ПараметрыЭлемента.Вставить("Disabled"					, ?(РеквизитыЭлемента.ПометкаУдаления, Истина, РеквизитыЭлемента.Отключен));
	ПараметрыЭлемента.Вставить("ApiKey"						, РеквизитыЭлемента.СОРВКлючДляApi);
	ПараметрыЭлемента.Вставить("AllowCalculateRemuneration"	, РеквизитыЭлемента.СОРВРасчетВознаграждений);
	ПараметрыЭлемента.Вставить("AllowGetCalculationRules"	, РеквизитыЭлемента.СОРВПолучениеПравилРасчета);
	ПараметрыЭлемента.Вставить("AllowAdmin"					, РеквизитыЭлемента.СОРВАдминистрирование);
	
КонецПроцедуры

Процедура ПолучитьНеобходимыеРеквизитыЭлемента_КВБанка(ПараметрыЭлемента, Элемент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	AMS_РазмерыКВБанков.Банк.ГУИД КАК bankId,
		|	AMS_РазмерыКВБанков.Риск.ГУИД КАК Risk,
		|	AMS_РазмерыКВБанков.РазмерКВ КАК Percentage,
		|   ""659f59af-787c-4e53-90aa-394593e95218"" КАК RemunerationKindId,
		|	AMS_РазмерыКВБанков.ДатаОкончанияДействия КАК DateEnd,
		|	AMS_РазмерыКВБанков.ДатаНачалаДействия КАК DateBegin,
		|	AMS_РазмерыКВБанков.ГУИД КАК ID
		|ИЗ
		|	РегистрСведений.AMS_РазмерыКВБанков КАК AMS_РазмерыКВБанков
		|ГДЕ
		|	AMS_РазмерыКВБанков.Регистратор = &Регистратор";
	
	Запрос.УстановитьПараметр("Регистратор", Элемент.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ПравилоКВ = ИнициализироватьСтруктуруПравила();
		ЗаполнитьЗначенияСвойств(ПравилоКВ, ВыборкаДетальныеЗаписи);
		
		ПравилоКВ.DateEnd = ?(ЗначениеЗаполнено(ПравилоКВ.DateEnd), ПравилоКВ.DateEnd, Неопределено);
		
		ПараметрыЭлемента.Добавить(ПравилоКВ);
	КонецЦикла;
	
КонецПроцедуры	

Процедура ПолучитьНеобходимыеРеквизитыЭлемента_СпрБанки(ПараметрыЭлемента, Элемент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	AMS_Банки.ГУИД КАК id,
		|	AMS_Банки.ИНН КАК inn,
		|	AMS_Банки.ИдентификаторКИАС КАК additionalAgentId
		|ИЗ
		|	Справочник.AMS_Банки КАК AMS_Банки
		|ГДЕ
		|	AMS_Банки.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Элемент.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ПравилоКВ = Новый Структура;
		ПравилоКВ.Вставить("id");
		ПравилоКВ.Вставить("inn");
		ПравилоКВ.Вставить("additionalAgentId");		
		
		ЗаполнитьЗначенияСвойств(ПравилоКВ, ВыборкаДетальныеЗаписи);
		ПараметрыЭлемента.Добавить(ПравилоКВ);
		
	КонецЦикла;
	
КонецПроцедуры	

Процедура ПолучитьНеобходимыеРеквизитыЭлемента_Банки(ПараметрыЭлемента, Элемент)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	AMS_СоответствиеАгентовИБанков.Банк.ИНН КАК inn,
		|	AMS_СоответствиеАгентовИБанков.Филиал.ГУИДФилиалаВЮПро КАК filialId,
		|	AMS_СоответствиеАгентовИБанков.Агент.ГУИД КАК agentID,
		|	AMS_СоответствиеАгентовИБанков.GUID КАК id
		|ИЗ
		|	РегистрСведений.AMS_СоответствиеАгентовИБанков КАК AMS_СоответствиеАгентовИБанков
		|ГДЕ
		|	AMS_СоответствиеАгентовИБанков.GUID = &GUID";
	
	Запрос.УстановитьПараметр("GUID", Элемент.GUID);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		ПараметрыЭлемента.Вставить("inn");
		ПараметрыЭлемента.Вставить("filialId");
		ПараметрыЭлемента.Вставить("agentID");
		ПараметрыЭлемента.Вставить("id");
		
		ЗаполнитьЗначенияСвойств(ПараметрыЭлемента, ВыборкаДетальныеЗаписи); 
		
	КонецЕсли;
		
КонецПроцедуры

Процедура ПолучитьНеобходимыеРеквизитыЭлемента_AMS_ДоговорАгента(ПараметрыЭлемента, Элемент)
	
	Источник = Элемент.Ссылка;
	ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, "ЭтоДопСоглашение, АгентскийДоговор");	
	ДоговорАгента	  = ?(ДанныеДокумента.ЭтоДопСоглашение, ДанныеДокумента.АгентскийДоговор, Источник);
	ДанныеПоПродавцам = РегистрыСведений.AMS_ИнформацияОПродавце.ПолучитьДанныеПродавца(ТекущаяДатаСеанса(),, ДоговорАгента);
	
	Пока ДанныеПоПродавцам.Следующий() Цикл
		
		РеквизитыСправочникаПродавец = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеПоПродавцам.Продавец, "ГУИД, ПометкаУдаления, Владелец");
		ДанныеВладельца = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыСправочникаПродавец.Владелец, "ГУИД, ТипКонтрагента,");
		Отключен = НЕ (ДанныеПоПродавцам.Действует И НЕ ДанныеПоПродавцам.Уволен И НЕ РеквизитыСправочникаПродавец.ПометкаУдаления);
		ГУИД_КаналПродаж = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеПоПродавцам.КаналПродаж, "ГУИД");
		ГУИД_ПодКаналПродаж = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеПоПродавцам.ПодканалПродаж, "ГУИД");
		ДанныеОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеПоПродавцам.ДокументОснование, "КатегорияКонтрагента, ГУИД");
		ДанныеФилиала = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеПоПродавцам.Филиал, "УровеньФилиала, ГУИД, Родитель");
		
		Если ДанныеФилиала.УровеньФилиала = 1 Тогда
			ГУИД_ФилиалПервогоУровня = ДанныеФилиала.ГУИД;
			ГУИД_ФилиалВторогоУровня = "";
		Иначе
			ГУИД_ФилиалПервогоУровня = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеФилиала.Родитель, "ГУИД");
			ГУИД_ФилиалВторогоУровня = ДанныеФилиала.ГУИД;
		КонецЕсли;
		
		ДанныеПродавца = Новый Структура();

		ДанныеПродавца.Вставить("id"				 , РеквизитыСправочникаПродавец.ГУИД);
		ДанныеПродавца.Вставить("disabled"			 , Отключен);  
		ДанныеПродавца.Вставить("partnerId"			 , ДанныеВладельца.ГУИД);
		ДанныеПродавца.Вставить("agencyAgreement"	 , ДанныеОснования.ГУИД);
		ДанныеПродавца.Вставить("partnerType"		 , Строка(ДанныеВладельца.ТипКонтрагента));
		ДанныеПродавца.Вставить("sellerCategory"	 , Строка(ДанныеОснования.КатегорияКонтрагента));
		ДанныеПродавца.Вставить("firstLevelFilialId" , ГУИД_ФилиалПервогоУровня);
		ДанныеПродавца.Вставить("secondLevelFilialId", ГУИД_ФилиалВторогоУровня);
		ДанныеПродавца.Вставить("saleChannelId"		 , ГУИД_КаналПродаж);
		ДанныеПродавца.Вставить("saleSubchannelId"	 , ГУИД_ПодКаналПродаж);
		
		ПараметрыЭлемента.Добавить(ДанныеПродавца);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПолучитьНеобходимыеРеквизитыЭлемента_AMS_ВидыВознаграждений(ПараметрыЭлемента, Элемент)
	
	РеквизитыЭлемента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Элемент.Ссылка, "ГУИД, Код, Наименование, ПометкаУдаления, Отключен, 
	| НаименованиеПолное, ЭтоГруппа");
	
	Если РеквизитыЭлемента.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;	

	ПараметрыЭлемента.Вставить("Id"				, РеквизитыЭлемента.ГУИД);
	ПараметрыЭлемента.Вставить("AdditionalID"	, РеквизитыЭлемента.Код);
	ПараметрыЭлемента.Вставить("Name"			, РеквизитыЭлемента.Наименование);
	ПараметрыЭлемента.Вставить("FullName"		, РеквизитыЭлемента.НаименованиеПолное);
	ПараметрыЭлемента.Вставить("Disabled"		, ?(РеквизитыЭлемента.ПометкаУдаления, Истина, РеквизитыЭлемента.Отключен));
	
КонецПроцедуры

Процедура ПолучитьНеобходимыеРеквизитыЭлемента_AMS_СтраховыеПродукты(ПараметрыЭлемента, Элемент)
	
	РеквизитыЭлемента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Элемент.Ссылка, "ГУИД, Код, Наименование, ПометкаУдаления, Отключен, 
	| НаименованиеПолное, ТребуетсяДополнительныйАгент");

	ПараметрыЭлемента.Вставить("Id"						, РеквизитыЭлемента.ГУИД);
	ПараметрыЭлемента.Вставить("AdditionalID"			, РеквизитыЭлемента.Код);
	ПараметрыЭлемента.Вставить("Name"					, РеквизитыЭлемента.Наименование);
	ПараметрыЭлемента.Вставить("FullName"				, РеквизитыЭлемента.НаименованиеПолное);
	ПараметрыЭлемента.Вставить("Disabled"				, ?(РеквизитыЭлемента.ПометкаУдаления, Истина, РеквизитыЭлемента.Отключен));
	ПараметрыЭлемента.Вставить("AdditionalAgentRequired", РеквизитыЭлемента.ТребуетсяДополнительныйАгент);
	
КонецПроцедуры

Процедура ПолучитьНеобходимыеРеквизитыЭлемента_AMS_НаборыДополнительныхУсловий(ПараметрыЭлемента, Элемент)
	
	НаборЗаписей = РегистрыСведений.AMS_ПереработатьИлиУдалитьНаборыДополнительныхУсловий.СоздатьНаборЗаписей();
	
	НаборЗаписей.Отбор.СтраховойПродукт.Установить(Элемент.СтраховойПродукт);
	НаборЗаписей.Отбор.ВидВознаграждения.Установить(Элемент.ВидВознаграждения);
	НаборЗаписей.Отбор.Параметр.Установить(Элемент.Параметр);
	
	НаборЗаписей.Прочитать();
	
	Для Каждого Запись Из НаборЗаписей Цикл
		
		ДанныеНабора = Новый Структура();
		
		ВидВознаграждения_ГУИД	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.ВидВознаграждения, "ГУИД");
		СтраховойПродукт_ГУИД	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.СтраховойПродукт	, "ГУИД");
		Параметр_ГУИД			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.Параметр			, "ГУИД");
		
		ДанныеНабора.Вставить("id"					, Запись.ГУИД);
		ДанныеНабора.Вставить("DateBegin"			, Запись.Период);
		ДанныеНабора.Вставить("RemunerationKindId"	, ВидВознаграждения_ГУИД);
		ДанныеНабора.Вставить("ProductId"			, СтраховойПродукт_ГУИД);
		ДанныеНабора.Вставить("Parameter"			, Параметр_ГУИД);
		ДанныеНабора.Вставить("Required"			, Запись.Обязательный);
		ДанныеНабора.Вставить("priority"			, Запись.Приоритет);		
		
		ПараметрыЭлемента.Добавить(ДанныеНабора);
		
	КонецЦикла;

КонецПроцедуры

Процедура ПолучитьНеобходимыеРеквизитыЭлемента_AMS_ОграниченияВознагражденийПоПродукту(ПараметрыЭлемента, Элемент)
	
	НаборЗаписей = РегистрыСведений.AMS_ОграниченияВознагражденийПоПродукту.СоздатьНаборЗаписей();
	
	НаборЗаписей.Отбор.СтраховойПродукт.Установить(Элемент.СтраховойПродукт);
	НаборЗаписей.Отбор.ВидВознаграждения.Установить(Элемент.ВидВознаграждения);
	НаборЗаписей.Отбор.СтраховойРиск.Установить(Элемент.СтраховойРиск);
	
	НаборЗаписей.Прочитать();
	
	Для Каждого Запись Из НаборЗаписей Цикл
		
		ДанныеНабора = Новый Структура();
		
		ВидВознаграждения_ГУИД	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.ВидВознаграждения, "ГУИД");
		СтраховойПродукт_ГУИД	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.СтраховойПродукт	, "ГУИД");
		СтраховойРиск_ГУИД		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.СтраховойРиск	, "ГУИД");
		
		
		ДанныеНабора.Вставить("Id"					 , Запись.ГУИД);
		ДанныеНабора.Вставить("DateBegin"			 , Запись.Период);
		ДанныеНабора.Вставить("ProductId"			 , СтраховойПродукт_ГУИД);
		ДанныеНабора.Вставить("RemunerationKindId"	 , ВидВознаграждения_ГУИД);
		ДанныеНабора.Вставить("Risk"				 , СтраховойРиск_ГУИД);
		ДанныеНабора.Вставить("CalculationPercentage", Запись.МаксимальныПроцент);
		ДанныеНабора.Вставить("RemunerationAmount"	 , ?(Запись.МаксимальноеВознаграждение = 0, null, Запись.МаксимальноеВознаграждение));
		
		ПараметрыЭлемента.Добавить(ДанныеНабора);
		
	КонецЦикла;

КонецПроцедуры

Процедура ПолучитьНеобходимыеРеквизитыЭлемента_AMS_ПравилаРасчетаВознаграждений(МассивПравил, Элемент, ГУИДыВидовСравнения)
	
	Настройки = Новый Структура();	
	
	Если (ТипЗнч(Элемент.Регистратор) = Тип("ДокументСсылка.AMS_ИзменениеДополнительногоКВИндивидуальное")
		ИЛИ ТипЗнч(Элемент.Регистратор) = Тип("ДокументСсылка.AMS_ИзменениеДополнительногоКВОбщее"))
		И ЗначениеЗаполнено(Элемент.Регистратор.ГУИДЦССУ) Тогда
		
		Возврат;
		
	КонецЕсли;	
	
	ЗапросИзмененияПравилКВ(Элемент, Настройки);
	СформироватьПакетПравил(МассивПравил, Настройки);

КонецПроцедуры

Процедура ПолучитьНеобходимыеРеквизитыЭлемента_AMS_ЛимитыКВБанковИАгентов(ПараметрыЭлемента, Элемент)
	
	НаборЗаписей = РегистрыСведений.AMS_ЛимитыКВБанковИАгентов.СоздатьНаборЗаписей();
	
	НаборЗаписей.Отбор.Идентификатор.Установить(Элемент.Идентификатор);
	
	НаборЗаписей.Прочитать();
	
	Для Каждого Запись Из НаборЗаписей Цикл
		
		ДанныеНабора = Новый Структура();
		
		БанкГУИД				= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.Банк		, "ГУИД");
		АгентГУИД				= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.Агент	, "ГУИД");
		СтраховойРиск_ГУИД		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.Риск		, "ГУИД");
		
		ДанныеНабора.Вставить("id"					, Число(Запись.Идентификатор));
		ДанныеНабора.Вставить("from"				, Формат(Запись.ДатаНачала, "ДФ=yyyy-MM-dd"));
		ДанныеНабора.Вставить("to"					, Формат(Запись.ДатаОкончания, "ДФ=yyyy-MM-dd"));
		ДанныеНабора.Вставить("bankId"	 			, БанкГУИД);
		ДанныеНабора.Вставить("agentId"				, АгентГУИД);
		ДанныеНабора.Вставить("riskId" 				, СтраховойРиск_ГУИД);
		ДанныеНабора.Вставить("maxKv"				, Запись.МаксимальноеКВ);
		
		ПараметрыЭлемента.Добавить(ДанныеНабора);
		
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработкаПравил

Процедура СформироватьПакетПравил(МассивПравил, Настройки)

	Данные  = Настройки.ДанныеВыгрузки;
	
	Если Данные.Количество() = 0 Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Для каждого Правило Из Данные Цикл
	
		ДополнитьПравилом(МассивПравил, Правило);
	
	КонецЦикла;
	
	
КонецПроцедуры	

Процедура ДополнитьПравилом(МассивПравил, Правило)
			
	СтраховойПродукт 	 = ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.СтраховойПродукт;
	КатегорияДоговора	 = ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.КатегорияДоговора;
	СтраховойРиск     	 = ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.СтраховойРиск;
	ТипАгента		  	 = ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.ТипАгента;
	ДополнительныйАгент  = ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.Банк;
	
	Если Правило.ЭтоКВБанка Тогда
		ГУИДПравила = Справочники.AMS_ВидыВознаграждений.КВБ.ГУИД;
	ИначеЕсли ТипЗнч(Правило.Регистратор) = Тип("ДокументСсылка.AMS_ИзменениеКВИндивидуальное") 
		ИЛИ ТипЗнч(Правило.Регистратор) = Тип("ДокументСсылка.AMS_ИзменениеКВОбщее") Тогда
		ГУИДПравила = Справочники.AMS_ВидыВознаграждений.БКВ.ГУИД;
	ИначеЕсли ТипЗнч(Правило.Регистратор) = Тип("ДокументСсылка.AMS_ИзменениеДополнительногоКВИндивидуальное") 
		ИЛИ ТипЗнч(Правило.Регистратор) = Тип("ДокументСсылка.AMS_ИзменениеДополнительногоКВОбщее") Тогда
		ГУИДПравила = Справочники.AMS_ВидыВознаграждений.ДКВ.ГУИД; 	
	КонецЕсли;	 
	
	СтруктураПравила = ИнициализироватьСтруктуруПравила();
	СтруктураПравила.ID 		= Правило.ГУИД;
	СтруктураПравила.DateBegin 	= Правило.Период;
	СтруктураПравила.DateEnd 	= ?(ЗначениеЗаполнено(Правило.ДатаОкончанияДействия), Правило.ДатаОкончанияДействия, null);
	СтруктураПравила.RemunerationKindId 	= ГУИДПравила;
	СтруктураПравила.ProductId 			= Правило.СтраховойПродукт;
	СтруктураПравила.Percentage 		= Правило.Процент;
	СтруктураПравила.PartnerId 			= Правило.Агент;
	СтруктураПравила.PartnerType 		= null;
	СтруктураПравила.SellerCategory 	= Правило.КатегорияПродавца;
	СтруктураПравила.SaleChannel 	 	= Правило.КаналПродаж;
	СтруктураПравила.SaleSubchannel 	= Правило.ПодканалПродаж;
	СтруктураПравила.FirstLevelFilial 	= Правило.Филиал;
	
	Для каждого Условие  Из Правило.КлючУсловий.НаборУсловий Цикл
		
		Если Условие.Параметр = СтраховойПродукт ИЛИ НЕ ЗначениеЗаполнено(Условие.Параметр) Тогда
			Продолжить;
		КонецЕсли;	
		
		Если Условие.Параметр = СтраховойРиск Тогда
			
			СтруктураПравила.Risk = ПолучитьЗначение(Условие, Условие.ОператорСравнения);;
			Продолжить;
			
		КонецЕсли;	
		
		Если Условие.Параметр = ТипАгента Тогда
			
			 СтруктураПравила.PartnerType = ПолучитьЗначение(Условие, Условие.ОператорСравнения);
			 Продолжить;

		КонецЕсли;	 
		
		Если Условие.Параметр = ДополнительныйАгент Тогда
			
			 СтруктураПравила.AdditionalAgent = ПолучитьЗначение(Условие, Условие.ОператорСравнения);
			 
			 // AGENTS-2863
			 Если НетБанкаПоИНН(СтруктураПравила.AdditionalAgent) Тогда
				 СтруктураПравила.AdditionalAgent = null;
			 КонецЕсли;
			 
			 //Продолжить;
			 // AGENTS-2863
			 
		КонецЕсли;
				
		СтруктураСтрокиУсловий = ИнициализироватьСтрокуУсловийКВ();	   	
		СтруктураСтрокиУсловий.Path = Условие.Параметр.ПутьКДанным;
		СтруктураСтрокиУсловий.dataTypeId = Условие.Параметр.ТипДанныхСОРВ.ГУИД;
		
		Если Условие.Параметр = КатегорияДоговора Тогда
			
			СтруктураСтрокиУсловий.Value = ПолучитьЗначение(Условие, Условие.ОператорСравнения);
			
		Иначе
			
			ТипЗначения = ТипЗнч(Условие.Значение);	
			
			Если ТипЗначения = Тип("ПеречислениеСсылка.Удалить_AMS_КатегорииТС")
				ИЛИ ТипЗначения = Тип("ПеречислениеСсылка.AMS_ВидТерриторииКонтрагента")
				ИЛИ ТипЗначения = Тип("ПеречислениеСсылка.AMS_ВидыСтраховыхПродуктов")
				ИЛИ ТипЗначения = Тип("ПеречислениеСсылка.AMS_КатегорииДоговораСтрахования")
				ИЛИ ТипЗначения = Тип("ПеречислениеСсылка.AMS_КатегорииПродавца")
				ИЛИ ТипЗначения = Тип("ПеречислениеСсылка.AMS_ПолФизическогоЛица")
				ИЛИ ТипЗначения = Тип("ПеречислениеСсылка.AMS_ТипыАгентовПоСпособуПродаж")
				ИЛИ ТипЗначения = Тип("ПеречислениеСсылка.AMS_ТипыКонтрагентов")
				ИЛИ ТипЗначения = Тип("ПеречислениеСсылка.AMS_ТипыСтраховыхПродуктовПоНС")
				ИЛИ ТипЗначения = Тип("ПеречислениеСсылка.Удалить_AMS_ЦелиИспользованияТС")
				ИЛИ ТипЗначения = Тип("ПеречислениеСсылка.Удалить_AMS_ФормыВыплат") Тогда
		
			    СтруктураСтрокиУсловий.Value = ПолучитьЗначение(Условие, Условие.ОператорСравнения);				
			ИначеЕсли ТипЗначения = Тип("СправочникСсылка.AMS_ЦелиИспользованияТС")
				ИЛИ ТипЗначения = Тип("СправочникСсылка.AMS_КатегорииТС")
				ИЛИ ТипЗначения = Тип("СправочникСсылка.AMS_ФормыВыплат") Тогда	
				
				СтруктураСтрокиУсловий.Value = ПолучитьЗначение(Условие, Условие.ОператорСравнения);	
				
			ИначеЕсли ТипЗначения = Тип("Булево") Тогда 	
				
				СтруктураСтрокиУсловий.Value = ПолучитьЗначение(Условие, Условие.ОператорСравнения);
				
			ИначеЕсли ТипЗначения = Тип("СправочникСсылка.AMS_ТерриторииСтрахования") Тогда 
				
				КодКладрБезПробела = Формат(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Условие.Значение, "КодКЛАДР"), "ЧГ=0");
				СтруктураСтрокиУсловий.Value = XMLСтрока(Лев(КодКладрБезПробела,8));
				
			Иначе
				
				СтруктураСтрокиУсловий.Value = ПолучитьЗначение(Условие, Условие.ОператорСравнения);
				
			КонецЕсли;	
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Условие.ОператорСравнения) Тогда
			
			СтруктураСтрокиУсловий.ConditionKindId = Условие.ОператорСравнения.ГУИД;
			
		КонецЕсли;	
		
		СтруктураПравила.AdditionalConditions.Добавить(СтруктураСтрокиУсловий);
		
	КонецЦикла;
	МассивПравил.Добавить(СтруктураПравила);
	
КонецПроцедуры	

Функция ИнициализироватьСтрокуУсловийКВ()
	
	 Результат = Новый Структура;
	 Результат.Вставить("ConditionKindId", "9821d79b-0d62-4543-84cd-4a4da5430173");
	 Результат.Вставить("Value");
	 Результат.Вставить("Path");
	 Результат.Вставить("dataTypeId");
	 
	 Возврат Результат;
	
КонецФункции	

Функция ИнициализироватьСтруктуруПравила()
	
	 Результат = Новый Структура();
	 Результат.Вставить("ID");
	 Результат.Вставить("DateBegin");
	 Результат.Вставить("DateEnd");
	 Результат.Вставить("RemunerationKindId");
	 Результат.Вставить("ProductId");
	 Результат.Вставить("Comment", "");
	 Результат.Вставить("Percentage");
	 Результат.Вставить("Performance");
	 Результат.Вставить("PartnerId");
	 Результат.Вставить("PartnerType");
	 Результат.Вставить("SellerCategory");
	 Результат.Вставить("FirstLevelFilial");
	 Результат.Вставить("SaleChannel");
	 Результат.Вставить("SaleSubchannel");
	 Результат.Вставить("AdditionalAgent");
	 Результат.Вставить("bankId");
	 Результат.Вставить("Risk");
	 Результат.Вставить("AdditionalConditions", Новый Массив);
	 
	 Возврат Результат;	 
	
КонецФункции	

Процедура ЗапросИзмененияПравилКВ(Элемент, Настройки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	AMS_ИндивидуальныеПравилаРасчетаКВ.Агент.ГУИД КАК Агент,
		|	AMS_ИндивидуальныеПравилаРасчетаКВ.Филиал.ГУИДФилиалаВЮПро КАК Филиал,
		|	AMS_ИндивидуальныеПравилаРасчетаКВ.СтраховойПродукт.ГУИД КАК СтраховойПродукт,
		|	AMS_ИндивидуальныеПравилаРасчетаКВ.КлючУсловий КАК КлючУсловий,
		|	AMS_ИндивидуальныеПравилаРасчетаКВ.Процент КАК Процент,
		|	AMS_ИндивидуальныеПравилаРасчетаКВ.Отменен КАК Отменен,
		|	AMS_ИндивидуальныеПравилаРасчетаКВ.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
		|	AMS_ИндивидуальныеПравилаРасчетаКВ.ГУИД КАК ГУИД,
		|	"""" КАК КаналПродаж,
		|	"""" КАК ПодканалПродаж,
		|	"""" КАК КатегорияПродавца,
		|	AMS_ИндивидуальныеПравилаРасчетаКВ.Период КАК Период,
		|	ВЫБОР
		|		КОГДА AMS_СоответствиеАгентовИБанков.Банк ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ЭтоКВБанка,
		|	AMS_ИндивидуальныеПравилаРасчетаКВ.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.AMS_ИндивидуальныеПравилаРасчетаКВ КАК AMS_ИндивидуальныеПравилаРасчетаКВ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.AMS_СоответствиеАгентовИБанков КАК AMS_СоответствиеАгентовИБанков
		|		ПО AMS_ИндивидуальныеПравилаРасчетаКВ.Агент = AMS_СоответствиеАгентовИБанков.Агент
		|ГДЕ
		|	AMS_ИндивидуальныеПравилаРасчетаКВ.Регистратор = &Регистратор
		|	И НЕ AMS_ИндивидуальныеПравилаРасчетаКВ.СтраховойПродукт.Наименование = """"
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	NULL,
		|	AMS_ОбщиеПравилаРасчетаКВ.Филиал.ГУИДФилиалаВЮПро,
		|	AMS_ОбщиеПравилаРасчетаКВ.СтраховойПродукт.ГУИД,
		|	AMS_ОбщиеПравилаРасчетаКВ.КлючУсловий,
		|	AMS_ОбщиеПравилаРасчетаКВ.Процент,
		|	AMS_ОбщиеПравилаРасчетаКВ.Отменен,
		|	AMS_ОбщиеПравилаРасчетаКВ.ДатаОкончанияДействия,
		|	AMS_ОбщиеПравилаРасчетаКВ.ГУИД,
		|	AMS_ОбщиеПравилаРасчетаКВ.КаналПродаж.ГУИД,
		|	AMS_ОбщиеПравилаРасчетаКВ.ПодканалПродаж.ГУИД,
		|	AMS_ОбщиеПравилаРасчетаКВ.КатегорияПродавца,
		|	AMS_ОбщиеПравилаРасчетаКВ.Период,
		|	ЛОЖЬ,

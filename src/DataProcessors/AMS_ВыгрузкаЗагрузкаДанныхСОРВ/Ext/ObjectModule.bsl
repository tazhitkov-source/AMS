//Определяет тип дополнительного параметра
Функция ОпределитьТипПараметра(ОписаниеТипа)

	Если НЕ ЗначениеЗаполнено(ОписаниеТипа) Тогда
		Возврат Тип("УникальныйИдентификатор");
	КонецЕсли;	
	
	Если ОписаниеТипа.СодержитТип(Тип("Число")) Тогда
		Результат = Тип("Число");
	ИначеЕсли ОписаниеТипа.СодержитТип(Тип("Булево")) Тогда
		Результат = Тип("Булево");
	ИначеЕсли ОписаниеТипа.СодержитТип(Тип("Дата")) Тогда
		Результат = Тип("Дата");
	ИначеЕсли ОписаниеТипа.СодержитТип(Тип("Строка")) Тогда
		Результат = Тип("Строка");
	Иначе
		Результат = Тип("УникальныйИдентификатор");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//Массивы сообщения заполняются соответствующими элементами
Функция ДобавитьТекущийЭлементВСтруктуруСообщения(Элемент, СтруктураСообщения, СоответствиеПолей, ГУИДыВидовСравнения, СоответствиеТипов)

	СоответствиеТиповЭлементов = СформироватьТипыЭлементов(Элемент);
	
	ТипЭлемента = СоответствиеТиповЭлементов.Получить(Элемент.Тип);
	
	Если ТипЭлемента = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	МассивКЗаполнению = СоответствиеПолей[ТипЭлемента];
	ПараметрыЭлемента = Новый Структура();
	
	Если ТипЭлемента = "Системы" Тогда
		
		ПолучитьНеобходимыеРеквизитыЭлемента_AMS_Системы(ПараметрыЭлемента, Элемент);
		СтруктураСообщения[МассивКЗаполнению].Добавить(ПараметрыЭлемента);
		
	ИначеЕсли ТипЭлемента = "Договор агента" Тогда
		
		ПолучитьНеобходимыеРеквизитыЭлемента_AMS_ДоговорАгента(СтруктураСообщения[МассивКЗаполнению], Элемент);
		
	ИначеЕсли ТипЭлемента = "Виды вознаграждений партнерам" Тогда
		
		ПолучитьНеобходимыеРеквизитыЭлемента_AMS_ВидыВознаграждений(ПараметрыЭлемента, Элемент);
		Если ПараметрыЭлемента.Свойство("id") Тогда
			СтруктураСообщения[МассивКЗаполнению].Добавить(ПараметрыЭлемента);		
		КонецЕсли;
		
	ИначеЕсли ТипЭлемента = "Страховые продукты" Тогда
		
		ПолучитьНеобходимыеРеквизитыЭлемента_AMS_СтраховыеПродукты(ПараметрыЭлемента, Элемент);
		СтруктураСообщения[МассивКЗаполнению].Добавить(ПараметрыЭлемента);
		
	ИначеЕсли ТипЭлемента = "AMS_ПереработатьИлиУдалитьНаборыДополнительныхУсловий" Тогда
		
		ПолучитьНеобходимыеРеквизитыЭлемента_AMS_НаборыДополнительныхУсловий(СтруктураСообщения[МассивКЗаполнению], Элемент);
		
	ИначеЕсли ТипЭлемента = "AMS_ПереработатьИлиУдалитьОграниченияВознагражденийПоПродукту" Тогда
		
		ПолучитьНеобходимыеРеквизитыЭлемента_AMS_ОграниченияВознагражденийПоПродукту(СтруктураСообщения[МассивКЗаполнению], Элемент);
		
	ИначеЕсли ТипЭлемента = "Правила расчета вознаграждений" Тогда
		
		ПолучитьНеобходимыеРеквизитыЭлемента_AMS_ПравилаРасчетаВознаграждений(СтруктураСообщения[МассивКЗаполнению], 
																				Элемент, ГУИДыВидовСравнения);
																				
	ИначеЕсли ТипЭлемента = "МотивационныеПрограммы" Тогда
		
		ПолучитьНеобходимыеРеквизитыЭлемента_AMS_ИзменениеУсловийМотивационнойПрограммы(СтруктураСообщения[МассивКЗаполнению], 
																					Элемент, ГУИДыВидовСравнения);																			
																					
	ИначеЕсли ТипЭлемента = "Банки" Тогда
		
		ПолучитьНеобходимыеРеквизитыЭлемента_Банки(ПараметрыЭлемента, Элемент);																				
		СтруктураСообщения[МассивКЗаполнению].Добавить(ПараметрыЭлемента);
		
	ИначеЕсли ТипЭлемента = "СпрБанки" Тогда
		
		ПолучитьНеобходимыеРеквизитыЭлемента_СпрБанки(СтруктураСообщения[МассивКЗаполнению], Элемент);																					
		
	ИначеЕсли ТипЭлемента = "КВБанка" Тогда
		
		ПолучитьНеобходимыеРеквизитыЭлемента_КВБанка(СтруктураСообщения[МассивКЗаполнению], Элемент);																					
		
		
	ИначеЕсли ТипЭлемента = "Параметры дополнительных условий" Тогда
		
		ПолучитьНеобходимыеРеквизитыЭлемента_AMS_ПараметрыДополнительныхУсловий(ПараметрыЭлемента, Элемент, СоответствиеТипов);
		СтруктураСообщения[МассивКЗаполнению].Добавить(ПараметрыЭлемента);
		
	ИначеЕсли ТипЭлемента = "Продавцы" Тогда
		
		ПолучитьНеобходимыеРеквизитыЭлемента_AMS_Продавцы(ПараметрыЭлемента, Элемент);
		
		Если ПараметрыЭлемента.Свойство("id") Тогда 
			СтруктураСообщения[МассивКЗаполнению].Добавить(ПараметрыЭлемента);
		КонецЕсли;	
		
	ИначеЕсли ТипЭлемента = "Лимиты КВ банков и агентов" Тогда
		
		ПолучитьНеобходимыеРеквизитыЭлемента_AMS_ЛимитыКВБанковИАгентов(СтруктураСообщения[МассивКЗаполнению], Элемент);
		
	Иначе
		
	КонецЕсли;
	
КонецФункции


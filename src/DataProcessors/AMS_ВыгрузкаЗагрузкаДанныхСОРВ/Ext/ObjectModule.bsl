	 Результат.Вставить("endDate");
	 Результат.Вставить("partner");
	 Результат.Вставить("filial");
	 Результат.Вставить("percent");
	 Результат.Вставить("SaleChannel");
	 Результат.Вставить("SaleSubchannel");


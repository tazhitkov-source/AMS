	Возврат Результат;
	
КонецФункции
                                                                                                        
//Формирует структуру из сообщения JSON
Функция ПолучитьСтруктуруJSON(ТекстСообщения)
	
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(ТекстСообщения);
	
	РеквизитыДат = Новый Массив;
	РеквизитыДат.Добавить("Дата");
	РеквизитыДат.Добавить("ДатаВыдачиДокумента");
	РеквизитыДат.Добавить("ДатаРождения");
	РеквизитыДат.Добавить("ДатаСоздания");
	РеквизитыДат.Добавить("НачалоДействия");
	РеквизитыДат.Добавить("КонецДействия");	
	РеквизитыДат.Добавить("ДатаНачалаДействия");
	РеквизитыДат.Добавить("ДатаОкончанияДействия");
	
	ДанныеJSON = ПрочитатьJSON(ЧтениеJSON,, РеквизитыДат, ФорматДатыJSON.ISO);	
	
	Возврат ДанныеJSON;	
		
КонецФункции

#КонецОбласти
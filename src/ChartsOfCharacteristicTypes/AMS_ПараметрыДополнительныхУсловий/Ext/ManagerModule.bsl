Процедура ВыполнитьОбновлениеПредопределенногоЭлемента() Экспорт;
	
	Идентификаторы					 = ИдентификаторыПредопределенногоЭлементаГУИД();
	ИдентификаторыПуть				 = ИдентификаторыПредопределенногоЭлементаПутьКДанным(); 
	ИдентификаторыТипДанных			 = ИдентификаторыПредопределенногоЭлементаТипыГУИД();
	ИдентификаторыМотивация			 = ИдентификаторыПредопределенногоЭлементаМотивация();
	ИдентификаторыОсновной			 = ИдентификаторыПредопределенногоЭлементаОсновной();
	ИдентификаторыДополнительный	 = ИдентификаторыПредопределенногоЭлементаДополнительный();
	
	Для каждого КлючЗначение Из Идентификаторы Цикл
		
		ПараметрыДополнительныхУсловийОбъект				 = КлючЗначение.Ключ.ПолучитьОбъект();
		ПараметрыДополнительныхУсловийОбъект.ГУИД			 = КлючЗначение.Значение;
		ПараметрыДополнительныхУсловийОбъект.ПутьКданным	 = ИдентификаторыПуть.Получить(КлючЗначение.Ключ);
		ПараметрыДополнительныхУсловийОбъект.ТипДанныхСОРВ	 = ИдентификаторыТипДанных.Получить(КлючЗначение.Ключ);
		ПараметрыДополнительныхУсловийОбъект.Мотивация		 = ИдентификаторыМотивация.Получить(КлючЗначение.Ключ);
		ПараметрыДополнительныхУсловийОбъект.Основной		 = ИдентификаторыОсновной.Получить(КлючЗначение.Ключ);
		ПараметрыДополнительныхУсловийОбъект.Дополнительный	 = ИдентификаторыДополнительный.Получить(КлючЗначение.Ключ);
		ПараметрыДополнительныхУсловийОбъект.Записать();
		
	КонецЦикла;
	
КонецПроцедуры


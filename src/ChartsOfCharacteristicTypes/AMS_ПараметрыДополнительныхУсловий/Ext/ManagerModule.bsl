#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Список  условий сравнения для параметра или типа значений
// Возвращаемое значение:
//  Массив из Строка
//
Функция ПолучитьДоступныеУсловияСравнения(ДляКого) Экспорт

	
	Условия = Новый Массив;

	Если ТипЗнч(ДляКого) = Тип("ПланВидовХарактеристикСсылка.AMS_ПараметрыДополнительныхУсловий") Тогда
			
		//   
		Если ДляКого.ДоступныеУсловияСравнения.Количество()>0 тогда
			
			Для каждого Строка из ДляКого.ДоступныеУсловияСравнения    цикл
				
				Условия.Добавить(Строка.УсловиеСравнения);
				
			Конеццикла;
			
			Возврат Условия;
					
		конецесли;	
		
		ТипС = ДляКого.ТипЗначения;
		
	Иначе
		
		ТипС = ДляКого; 
		
	конецесли;
	
	
	Если  ТипС.СодержитТип(Тип("Булево")) Тогда	
		
		Условия.Добавить(Перечисления.AMS_ВидыСравнения.Равно); 
		
	ИначеЕсли  ТипС.СодержитТип(Тип("Строка")) Тогда	
		
		Условия.Добавить(Перечисления.AMS_ВидыСравнения.Равно);
		Условия.Добавить(Перечисления.AMS_ВидыСравнения.НеРавно); 
		Условия.Добавить(Перечисления.AMS_ВидыСравнения.Заполнено);
		Условия.Добавить(Перечисления.AMS_ВидыСравнения.НеЗаполнено);
		
	ИначеЕсли  ТипС.СодержитТип(Тип("Дата")) или ТипС.СодержитТип(Тип("Число")) Тогда		    
		
		Условия.Добавить(Перечисления.AMS_ВидыСравнения.Равно); 
		Условия.Добавить(Перечисления.AMS_ВидыСравнения.НеРавно);
		
		Условия.Добавить(Перечисления.AMS_ВидыСравнения.БольшеИлиРавно); 
		Условия.Добавить(Перечисления.AMS_ВидыСравнения.МеньшеИлиРавно);
		
		Условия.Добавить(Перечисления.AMS_ВидыСравнения.Больше); 
		Условия.Добавить(Перечисления.AMS_ВидыСравнения.Меньше);
		
		Условия.Добавить(Перечисления.AMS_ВидыСравнения.Заполнено);
		Условия.Добавить(Перечисления.AMS_ВидыСравнения.НеЗаполнено);
		
	Иначе  //ссылочные типы
		
		Условия.Добавить(Перечисления.AMS_ВидыСравнения.Равно);
		Условия.Добавить(Перечисления.AMS_ВидыСравнения.НеРавно); 
		Условия.Добавить(Перечисления.AMS_ВидыСравнения.Заполнено);
		Условия.Добавить(Перечисления.AMS_ВидыСравнения.НеЗаполнено);
		Условия.Добавить(Перечисления.AMS_ВидыСравнения.ВСписке);
		Условия.Добавить(Перечисления.AMS_ВидыСравнения.НеВСписке);
		
	КонецЕсли;
			
	
	Возврат Условия;
	
КонецФункции

#Область СлужебныеПроцедурыИФункции

Процедура ВыполнитьОбновлениеПредопределенных() Экспорт;
	
	Идентификаторы					 = ИдентификаторыПредопределенныхДанныхГУИД();
	ИдентификаторыПуть				 = ИдентификаторыПредопределенныхДанныхПутьКДанным(); 
	ИдентификаторыТипДанных			 = ИдентификаторыПредопределенныхДанныхТипыГУИД();
	ИдентификаторыМотивация			 = ИдентификаторыПредопределенныхДанныхМотивация();
	ИдентификаторыОсновной			 = ИдентификаторыПредопределенныхДанныхОсновной();
	ИдентификаторыДополнительный	 = ИдентификаторыПредопределенныхДанныхДополнительный();
	
	Для каждого КлючЗначение Из Идентификаторы Цикл
		
		ПараметрыДополнительныхУсловийОбъект				 = КлючЗначение.Ключ.ПолучитьОбъект();
		ПараметрыДополнительныхУсловийОбъект.ГУИД			 = КлючЗначение.Значение;
		ПараметрыДополнительныхУсловийОбъект.ПутьКданным	 = ИдентификаторыПуть.Получить(КлючЗначение.Ключ);
		ПараметрыДополнительныхУсловийОбъект.ТипДанныхСОРВ	 = ИдентификаторыТипДанных.Получить(КлючЗначение.Ключ);
		ПараметрыДополнительныхУсловийОбъект.Мотивация		 = ИдентификаторыМотивация.Получить(КлючЗначение.Ключ);
		ПараметрыДополнительныхУсловийОбъект.Основной		 = ИдентификаторыОсновной.Получить(КлючЗначение.Ключ);
		ПараметрыДополнительныхУсловийОбъект.Дополнительный	 = ИдентификаторыДополнительный.Получить(КлючЗначение.Ключ);
		ПараметрыДополнительныхУсловийОбъект.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Функция ИдентификаторыПредопределенныхДанныхОсновной()
	
	Результат = Новый Соответствие;
	
	Результат.Вставить(ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.Банк,							 Истина);
	Результат.Вставить(ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.ТипАгента,					 Ложь);
	Результат.Вставить(ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.СтраховойРиск,				 Истина);
	Результат.Вставить(ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.СтраховойПродукт,				 Ложь);
	Результат.Вставить(ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.Верификация,					 Ложь);
	Результат.Вставить(ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.ГодСтрахования,				 Истина);
	Результат.Вставить(ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.КатегорияДоговора,			 Истина);
	Результат.Вставить(ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.КБМ,							 Истина);
	Результат.Вставить(ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.Премия,						 Истина);
	Результат.Вставить(ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.ПрограммаПеревод,				 Ложь);
	Результат.Вставить(ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.Пролонгация,					 Ложь);
	Результат.Вставить(ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.ТипКонтрагентаСтрахователя,	 Ложь);
	Результат.Вставить(ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.ФормаВыплаты,					 Ложь);
	Результат.Вставить(ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.Франшиза,						 Ложь);
	Результат.Вставить(ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.ЭтоЕОСАГО,					 Истина);
	Результат.Вставить(ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.ПрограммаПереход,				 Ложь);
	Результат.Вставить(ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.ЦельИспользованияТС,			 Ложь);
	Результат.Вставить(ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.ТипТС,						 Ложь);
	Результат.Вставить(ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.РегионСобственника,			 Ложь);
	Результат.Вставить(ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.ТипКонтрагентаСобственника,	 Истина);
	Результат.Вставить(ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.ДебиторскаяЗадолженность, Ложь);
	Результат.Вставить(ПланыВидовХарактеристик.AMS_ПараметрыДополнительныхУсловий.ВидСтраховогоПродукта,		 Ложь);
	
	Возврат Результат;
	
КонецФункции


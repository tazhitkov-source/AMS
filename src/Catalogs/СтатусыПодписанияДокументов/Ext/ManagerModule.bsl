Процедура ЗаполнитьЗначениеПредопределенныйЭлемент(Данные, Менеджер)

	ЭлементОбъект = Менеджер[Данные.Элемент].ПолучитьОбъект();
	ЭлементОбъект.ПолноеНаименование = ЭлементОбъект.Наименование;
	ЭлементОбъект.Идентификатор = Данные.Идентификатор;
	ЭлементОбъект.Записать();
		

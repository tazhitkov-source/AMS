	Письмо = Новый Структура;
	Письмо.Вставить("Кому", Получатель);
	Письмо.Вставить("ПолучателиСообщения", Получатель);
	Письмо.Вставить("Тема", Тема);
	Письмо.Вставить("Тело", Сообщение);

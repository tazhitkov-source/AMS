
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ПодключаемыеКоманды") Тогда
		МодульПодключаемыеКоманды = ОбщегоНазначения.ОбщийМодуль("ПодключаемыеКоманды");
		МодульПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды 
	
	ПодготовкаФормы();
	
КонецПроцедуры 

&НаКлиенте
Процедура ПриОткрытии(Отказ) 
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.ПодключаемыеКоманды") Тогда
		МодульПодключаемыеКомандыКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ПодключаемыеКомандыКлиент");
		МодульПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ВидимостьЭлементовБлокировки();
	ОбновитьВидимостьДатыВыплаты();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ПодключаемыеКоманды") Тогда
		МодульПодключаемыеКомандыКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ПодключаемыеКомандыКлиентСервер");
		МодульПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ЗаполнитьТЧПродавцыНаСервере();
	
	ПодготовкаФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.ПодключаемыеКоманды") Тогда
		МодульПодключаемыеКомандыКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ПодключаемыеКомандыКлиент");
		МодульПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры 

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник) 
	
	Если ИмяСобытия = "AMS_ОбновленаИнформацияОПродавцах" Тогда
		ЗаполнитьТЧПродавцыНаСервере();
	КонецЕсли;
	
	Если ИмяСобытия = "AMS_ИзменениеДействияДоговора" Тогда
		ИзменениеСостоянияДоговораНаСервере(Параметр);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура БлокировкаАГДПриИзменении(Элемент)
	ВидимостьЭлементовБлокировки();	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если НЕ Объект.БлокировкаАГД Тогда
		Объект.ДатаОкончанияДействияБлокировки = '00010101';
		Объект.ДатаОкончанияДействияБлокировки = '00010101';
		Объект.Комментарий = "";
	КонецЕсли;
	
	ВидимыеПоля = СоответствиеПолей(Объект.ПериодичностьВыплатыКВ);
	ИменаПолей = ПоляДатыВыплаты();

	Для Каждого ИмяПоля Из ИменаПолей Цикл
		
		Если ВидимыеПоля.Найти(ИмяПоля) = Неопределено Тогда
			Объект[ИмяПоля] = "";
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект[ИмяПоля]) 
			И Элементы[ИмяПоля].Видимость Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнена дата выплаты",,,"Объект." + ИмяПоля, Истина);
			Отказ = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодичностьВыплатыКВПриИзменении(Элемент)
	
	ОбновитьВидимостьДатыВыплаты();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура РегистрационныйНомерПриИзменении(Элемент)
	
	Объект.Наименование = СтрШаблон("Договор № %1", Объект.РегистрационныйНомер); 
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияДействияПриИзменении(Элемент)
	
	Если Объект.ДатаОкончанияДействия <= Объект.ДатаНачалаДействия Тогда 
		ОбщегоНазначенияКлиент.СообщитьПользователю("Дата окончания действия не может быть меньше или равна дате начала действия", Объект.Ссылка, "ДатаОкончанияДействия", "Объект.ДатаОкончанияДействия");
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ДатаПодписанияАгентомПриИзменении(Элемент)
	
	Если Объект.ДатаПодписанияАгентом < Объект.ДатаНачалаДействия Тогда 
		ОбщегоНазначенияКлиент.СообщитьПользователю("Дата подписания агентом не может быть меньше даты начала действия", Объект.Ссылка, "ДатаПодписанияАгентом", "Объект.ДатаПодписанияАгентом");
	КонецЕсли;
	
	Если Объект.ДатаПодписанияАгентом >= Объект.ДатаОкончанияДействия Тогда 
		ОбщегоНазначенияКлиент.СообщитьПользователю("Дата подписания агентом не может быть больше даты окончания действия", Объект.Ссылка, "ДатаПодписанияАгентом", "Объект.ДатаПодписанияАгентом");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодразделениеОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	
	//Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда

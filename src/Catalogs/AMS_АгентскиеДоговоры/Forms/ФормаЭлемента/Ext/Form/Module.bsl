КонецПроцедуры

&НаКлиенте
Процедура АктивироватьДоговор(Команда)
	
	АктивироватьДоговорНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура АктивироватьДоговорНаСервере() 
	
	Объект.Статус = Перечисления.AMS_СтатусыАД.Действует;
	
	ПодготовкаФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ВозобновлениеДействия(Команда)  
	
	ПараметрыФормы = Новый Структура("ТипОперации", "ВозобновлениеДействия"); 
	
	ОткрытьФорму("Справочник.AMS_АгентскиеДоговоры.Форма.ФормаИзменениеДействияДоговора", ПараметрыФормы,,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриостановкаДействия(Команда)
	
	ПараметрыФормы = Новый Структура("ТипОперации", "ПриостановкаДействия"); 
	
	ОткрытьФорму("Справочник.AMS_АгентскиеДоговоры.Форма.ФормаИзменениеДействияДоговора", ПараметрыФормы,,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПодготовкаФормы()
	
	ЭтоАктивныйДоговор = Объект.Статус = Перечисления.AMS_СтатусыАД.Действует;
	ЭтоПроект = Объект.Статус = Перечисления.AMS_СтатусыАД.Проект;
	
	Если ЭтоПроект Тогда 
		
		Элементы.ФормаАктивироватьДоговор.Видимость = Истина;
		Элементы.ФормаПриостановкаДействия.Видимость = Ложь;
		Элементы.ФормаВозобновлениеДействия.Видимость = Ложь;
		
	Иначе
		
		Элементы.ФормаАктивироватьДоговор.Видимость = Ложь;
		Элементы.ФормаПриостановкаДействия.Видимость = ЭтоАктивныйДоговор;
		Элементы.ФормаВозобновлениеДействия.Видимость = Не ЭтоАктивныйДоговор;
		
	КонецЕсли;
	
КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды


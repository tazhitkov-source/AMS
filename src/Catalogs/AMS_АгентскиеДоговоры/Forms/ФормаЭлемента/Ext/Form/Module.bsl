КонецПроцедуры

// Конец СтандартныеПодсистемы.ПодключаемыеКоманды 

&НаКлиенте
Процедура ДополнитьСтруктуруЗаполнения(ИмяОперации, СтруктураЗаполнения)
	
	Если Не ТипЗнч(СтруктураЗаполнения) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураЗаполнения.Вставить("Агент", Объект.Владелец);
	СтруктураЗаполнения.Вставить("АгентскийДоговор", Объект.Ссылка);
	СтруктураЗаполнения.Вставить("Организация", Объект.Организация);
	СтруктураЗаполнения.Вставить("Филиал", Филиал);
	СтруктураЗаполнения.Вставить("Подразделение", Объект.Подразделение);
	
	Если Не ИмяОперации = "ДобавлениеПродавца" Тогда
		
		СтруктураЗаполнения.Вставить("Продавцы", ЗаполнитьМассивПродавцов());
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьМассивПродавцов()
	
	МассивПродавцов =  Новый Массив;
	
	Для Каждого Строка Из Элементы.Продавцы.ВыделенныеСтроки Цикл
		
		СтруктураСтроки = Новый Структура("Продавец, Уволен, Куратор, ВидТерритории, КаналПродаж, ПодканалПродаж, ФункциональнаяПринадлежность");
		
		ЗаполнитьЗначенияСвойств(СтруктураСтроки, Продавцы.НайтиПоИдентификатору(Строка));
		
		МассивПродавцов.Добавить(СтруктураСтроки);
		
	КонецЦикла;	
	
	Возврат МассивПродавцов;
	
КонецФункции

&НаКлиенте
Процедура ИзменениеДанныхПоПродавцамПродолжение(Параметры, ДопПараметры) Экспорт
	
	ЗаполнитьТЧПродавцыНаСервере();
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьТЧПродавцыНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	AMS_ИнформацияОПродавцеСрезПоследних.Продавец КАК Продавец,
	|	AMS_ИнформацияОПродавцеСрезПоследних.Уволен КАК Уволен,
	|	AMS_ИнформацияОПродавцеСрезПоследних.Куратор КАК Куратор,
	|	AMS_ИнформацияОПродавцеСрезПоследних.ВидТерритории КАК ВидТерритории,
	|	AMS_ИнформацияОПродавцеСрезПоследних.КаналПродаж КАК КаналПродаж,
	|	AMS_ИнформацияОПродавцеСрезПоследних.ПодканалПродаж КАК ПодканалПродаж,
	|	AMS_ИнформацияОПродавцеСрезПоследних.ФункциональнаяПринадлежность КАК ФункциональнаяПринадлежность
	|ИЗ
	|	РегистрСведений.AMS_ИнформацияОПродавце.СрезПоследних(&ДатаСреза, АгентскийДоговор = &АгентскийДоговор) КАК AMS_ИнформацияОПродавцеСрезПоследних";
	
	Запрос.УстановитьПараметр("АгентскийДоговор", Объект.Ссылка);
	Запрос.УстановитьПараметр("ДатаСреза", ТекущаяДатаСеанса());
	
	Результат = запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Продавцы.Очистить();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Продавцы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ИзменениеСостоянияДоговораНаСервере(Параметр)
	
	Если Параметр.Свойство("Статус") И Параметр.Статус.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Если Параметр.ТипОперации = "ВозобновлениеДействия" Тогда 
		
		Объект.ДатаПрекращенияДействия = Дата(1,1,1);
		Объект.ПричинаРасторжения = "";
		Статус = Перечисления.AMS_СтатусыАД.Действует;
		
	КонецЕсли;	
	
	Если Параметр.ТипОперации = "ПриостановкаДействия" Тогда 
		
		Объект.ДатаПрекращенияДействия = Параметр.Дата;
		Объект.ПричинаРасторжения = Параметр;
		Статус = Параметр.Статус; 
		
	КонецЕсли;
	
	Объект.Статус = Статус; 
	
	ПодготовкаФормы();
		
КонецПроцедуры


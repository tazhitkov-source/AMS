	//	
	//КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура АгентОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) И
		ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.AMS_Агенты") Тогда
		
		РеквизитыОбъекта = ПолучитьЗначениеРеквизитов(ВыбранноеЗначение, "ТабельныйНомер, ТипАгента");
		Объект.ТабельныйНомерАгента = РеквизитыОбъекта.ТабельныйНомер;
		Объект.ТипАгента = РеквизитыОбъекта.ТипАгента; 
		
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы 

&НаКлиенте
Процедура ДобавитьПродавца(Команда) 
	
	Если Объект.Ссылка.Пустая() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо записать агентский договор");
		Возврат;
	КонецЕсли;	
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ИзменениеДанныхПоПродавцамПродолжение", ЭтаФорма);
	
	СтруктураЗаполнения = Новый Структура;
	СтруктураЗаполнения.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.AMS_ВидИзмененияОперацииОПродавце.ДобавлениеПродавцов"));
	
	ДополнитьСтруктуруЗаполнения("ДобавлениеПродавца", СтруктураЗаполнения);
	
	ПараметрыОткрытия = Новый Структура("ЗначенияЗаполнения", СтруктураЗаполнения);
	
	ОткрытьФорму("Документ.AMS_ИзмененияДанныхПродавцов.ФормаОбъекта", ПараметрыОткрытия, ЭтаФорма,,,, ОповещениеОЗакрытии);	
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПродавца(Команда)
	
	Если Объект.Ссылка.Пустая() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо записать агентский договор");
		Возврат;
	КонецЕсли;
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ИзменениеДанныхПоПродавцамПродолжение", ЭтаФорма);
	
	СтруктураЗаполнения = Новый Структура;
	СтруктураЗаполнения.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.AMS_ВидИзмененияОперацииОПродавце.ИзменениеИнформации"));
	
	ДополнитьСтруктуруЗаполнения("ИзменениеИнформации", СтруктураЗаполнения);
	
	ПараметрыОткрытия = Новый Структура("ЗначенияЗаполнения", СтруктураЗаполнения);
	
	ОткрытьФорму("Документ.AMS_ИзмененияДанныхПродавцов.ФормаОбъекта", ПараметрыОткрытия, ЭтаФорма,,,, ОповещениеОЗакрытии); 
	
КонецПроцедуры


&НаСервере
Процедура ЗаполнитьКВНаСервере()
	
	Отбор = ДанныеКВСервер.ИнициализироватьСтруктуруОтбора();
	Отбор.Агент = Объект.Владелец;
	ТаблицаКВДанные = ДанныеКВСервер.ПолучитьТаблицуБазовогоКВИндивидуального(Отбор);
	
	Если Элементы.Найти("ТаблицаКВ") <> Неопределено Тогда
		
		УдаляемыеРеквизиты = Новый Массив;
		УдаляемыеРеквизиты.Добавить("ТаблицаКВ");
		ИзменитьРеквизиты(, УдаляемыеРеквизиты);	
		Элементы.Удалить(Элементы["ТаблицаКВ"]);
		
	КонецЕсли;
	
	РеквизитыФормы = Новый Массив;
	РеквизитыФормы.Добавить(Новый РеквизитФормы("ТаблицаКВ", Новый ОписаниеТипов("ТаблицаЗначений")));
	Для каждого Колонка Из ТаблицаКВДанные.Колонки Цикл
	
		РеквизитыФормы.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, "ТаблицаКВ"));
	
	КонецЦикла;
	ИзменитьРеквизиты(РеквизитыФормы);
				
	Таблица = Элементы.Добавить("ТаблицаКВ", Тип("ТаблицаФормы"), Элементы.РазмерыБазовогоКВ);
	Таблица.ПутьКДанным = "ТаблицаКВ";
	Таблица.УстановитьДействие("Выбор", "ПоказатьРасшифровкуКВ");
	
	
	Для каждого Колонка Из ТаблицаКВДанные.Колонки Цикл
	
		Реквизит = Элементы.Добавить("Колонка" + Колонка.Имя, Тип("ПолеФормы"), Таблица);;
	    Реквизит.Вид = ВидПоляФормы.ПолеНадписи;
		Реквизит.ПутьКДанным = "ТаблицаКВ." + Колонка.Имя;
		Реквизит.Заголовок   = Колонка.Имя;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ТаблицаКВДанные, "ТаблицаКВ");

КонецПроцедуры


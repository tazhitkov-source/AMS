&НаСервереБезКонтекста
Функция ПериодМотивационнойПрограммы(МотивационнаяПрограмма, Агент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	AMS_ПравилаРасчетаВознагражденияПоМотивационнымПрограммамСрезПоследних.ДатаНачалаДействия КАК ДатаНачалаДействия,
		|	ВЫБОР
		|		КОГДА AMS_ПравилаРасчетаВознагражденияПоМотивационнымПрограммамСрезПоследних.ДатаИсключения <> ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА AMS_ПравилаРасчетаВознагражденияПоМотивационнымПрограммамСрезПоследних.ДатаИсключения
		|	КОНЕЦ КАК ДатаОкончанияДействия
		|ИЗ
		|	РегистрСведений.AMS_ПравилаРасчетаВознагражденияПоМотивационнымПрограммам.СрезПоследних КАК AMS_ПравилаРасчетаВознагражденияПоМотивационнымПрограммамСрезПоследних
		|ГДЕ
		|	AMS_ПравилаРасчетаВознагражденияПоМотивационнымПрограммамСрезПоследних.МотивационнаяПрограмма = &МотивационнаяПрограмма
		|	И AMS_ПравилаРасчетаВознагражденияПоМотивационнымПрограммамСрезПоследних.Агент = &Агент";
	
	Запрос.УстановитьПараметр("Агент", Агент);
	Запрос.УстановитьПараметр("АгентИсключен", Ложь);
	Запрос.УстановитьПараметр("МотивационнаяПрограмма", МотивационнаяПрограмма);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	СтруктураДат = Новый Структура("ДатаНачалаДействия, ДатаОкончанияДействия");
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		ЗаполнитьЗначенияСвойств(СтруктураДат, ВыборкаДетальныеЗаписи);
		
	КонецЕсли;
	
	Возврат СтруктураДат;
	
КонецФункции

&НаКлиенте
Процедура МотивационныеПрограммыМотивационнаяПрограммаОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	
	СтруктураПоиска = Новый Структура("МотивационнаяПрограмма", ВыбранноеЗначение);
	Дубль = Объект.МотивационныеПрограммы.НайтиСтроки(СтруктураПоиска);
	
	Если Дубль.Количество() = 0 Тогда
		
		Период = ПериодМотивационнойПрограммы(ВыбранноеЗначение, Объект.Владелец);
		Строка = Элементы.МотивационныеПрограммы.ТекущиеДанные;
		ЗаполнитьЗначенияСвойств(Строка, Период);
		
	Иначе
		
		СтандартнаяОбработка = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидимостьЭлементовБлокировки()
	Элементы.ДатаНачалаДействияБлокировки.Видимость		 = Объект.БлокировкаАГД;
	Элементы.ДатаОкончанияДействияБлокировки.Видимость	 = Объект.БлокировкаАГД;
	Элементы.Комментарий.Видимость						 = Объект.БлокировкаАГД;	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьДатыВыплаты()

	ВидимыеПоля = СоответствиеПолей(Объект.ПериодичностьВыплатыКВ);
	ИменаПолей = ПоляДатыВыплаты();
	
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		ЭлементДаты = Элементы[ИмяПоля];
		ЭлементДаты.Видимость = ВидимыеПоля.Найти(ИмяПоля) <> Неопределено;
		ЭлементДаты.АвтоОтметкаНезаполненного = ЭлементДаты.Видимость;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ПоляДатыВыплаты()

	Результат = Новый Массив;
	
	Результат.Добавить("ДатаВыплаты1");
	Результат.Добавить("ДатаВыплаты2");
	Результат.Добавить("ДатаВыплаты3");
	Результат.Добавить("ДатаВыплаты4");
	
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция СоответствиеПолей(ПереодичностьВыплатыКВ)
	
	ИменаПолей = Новый Соответствие;
	
	ИменаПолей.Вставить(Перечисления.AMS_РасписаниеВыплатыКВ.Ежемесячно, "ДатаВыплаты1");
	ИменаПолей.Вставить(Перечисления.AMS_РасписаниеВыплатыКВ.Ежеквартально, "ДатаВыплаты1");
	ИменаПолей.Вставить(Перечисления.AMS_РасписаниеВыплатыКВ.РазВДвеНедели, "ДатаВыплаты1, ДатаВыплаты2");
	ИменаПолей.Вставить(Перечисления.AMS_РасписаниеВыплатыКВ.ДваРазаВМесяц, "ДатаВыплаты1, ДатаВыплаты2");
	ИменаПолей.Вставить(Перечисления.AMS_РасписаниеВыплатыКВ.Еженедельно, "ДатаВыплаты1, ДатаВыплаты2, ДатаВыплаты3, ДатаВыплаты4");

	ИменаВидимыхПолей = ИменаПолей.Получить(ПереодичностьВыплатыКВ);
	
	Если ИменаВидимыхПолей = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Возврат СтрРазделить(ИменаВидимыхПолей, ", ", Ложь);

КонецФункции


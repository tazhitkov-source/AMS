Функция ВыбратьСтраховыеПродукты(ГУИД)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	AMS_СтраховыеПродукты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.AMS_СтраховыеПродукты КАК AMS_СтраховыеПродукты
		|ГДЕ
		|	AMS_СтраховыеПродукты.ГУИД В(&ГУИД)";
	
	Запрос.УстановитьПараметр("ГУИД", ГУИД);
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

Процедура ЗаполнитьРеквизиты(Выборка);
	
	Пока Выборка.Следующий() Цикл 
		
		ОбъектПродукты = Выборка.Ссылка.ПолучитьОбъект();
		ОбъектПродукты.ОбязательноеСтрахование = Истина;
		ОбъектПродукты.ОбменДанными.Загрузка = Истина;
		ОбъектПродукты.Записать();
		
	КонецЦикла;
	
КонецПроцедуры


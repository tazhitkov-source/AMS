#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура СформироватьИзменитьЭлементСправочника(ИсходныеДанные) Экспорт
	
	Для Каждого Строка Из ИсходныеДанные Цикл 
		
		Если Не Строка.Свойство("ФункциональныеПринадлежности") Тогда
			
			Комментарий = "Для справочника не заполнен обязательный реквизит ФункциональныеПринадлежности";
			
			ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Загрузка справочника Функциональные принадлежности", УровеньЖурналаРегистрации.Ошибка,,, Комментарий);
			
			Возврат;
			
		КонецЕсли;	
		
		СправочникЭлемент = Справочники.AMS_ФункциональныеПринадлежности.НайтиПоРеквизиту("ГУИДЦССУ", Строка.ФункциональныеПринадлежности); 
		
		Если СправочникЭлемент.Пустая() Тогда 
			
			Если Строка.ЭтоГруппа Тогда
				
				СправочникОбъект = Справочники.AMS_ФункциональныеПринадлежности.СоздатьГруппу();
				
			Иначе
				
				СправочникОбъект = Справочники.AMS_ФункциональныеПринадлежности.СоздатьЭлемент();
				
			КонецЕсли;	
			
		Иначе
			
			СправочникОбъект = СправочникЭлемент.ПолучитьОбъект();
			
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СправочникОбъект, Строка, "Наименование");
		
		Если Не Строка.ЭтоГруппа Тогда 
			
			ЗаполнитьЗначенияСвойств(СправочникОбъект, Строка);
			
		КонецЕсли;
		
		ДозаполнитьОбъектФизЛица(СправочникОбъект, Строка, Строка.ЭтоГруппа);
		
		Попытка
			
			СправочникОбъект.Записать();
			
			Комментарий = СтрШаблон("Успешно записана функциональная принадлежность с УИД %1", Строка.ФункциональныеПринадлежности);
			
			ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Загрузка справочника Функциональные принадлежности", УровеньЖурналаРегистрации.Информация, Метаданные.Справочники.AMS_ФункциональныеПринадлежности, СправочникОбъект.Ссылка, Комментарий);
			
		Исключение 
			
			ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Загрузка справочника Функциональные принадлежности", УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.AMS_ФункциональныеПринадлежности, СправочникОбъект.Ссылка, ОписаниеОшибки());
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры 

Процедура ДозаполнитьОбъектФизЛица(АгентЛицаОбъект, Строка, ЭтоГруппа) 
	
	АгентЛицаОбъект.Родитель = Справочники.AMS_ФункциональныеПринадлежности.НайтиПоРеквизиту("ГУИДЦССУ", Строка.Родитель);
	АгентЛицаОбъект.ГУИДЦССУ = Строка.ФункциональныеПринадлежности;
	АгентЛицаОбъект.ГУИД = Строка.ГУИД;
	
	Если ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
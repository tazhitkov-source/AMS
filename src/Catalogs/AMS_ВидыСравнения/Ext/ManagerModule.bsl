КонецФункции

Функция ИдентификаторыПредопределенныхДанныхВидСравнения()
	
	Результат = Новый Соответствие;
	
	Результат.Вставить(Справочники.AMS_ВидыСравнения.Равно,				 Перечисления.AMS_ВидыСравнения.Равно);
	Результат.Вставить(Справочники.AMS_ВидыСравнения.НеРавно,			 Перечисления.AMS_ВидыСравнения.НеРавно);
	Результат.Вставить(Справочники.AMS_ВидыСравнения.БольшеИлиРавно,	 Перечисления.AMS_ВидыСравнения.БольшеИлиРавно);
	Результат.Вставить(Справочники.AMS_ВидыСравнения.МеньшеИлиРавно,	 Перечисления.AMS_ВидыСравнения.МеньшеИлиРавно);
	Результат.Вставить(Справочники.AMS_ВидыСравнения.Больше,			 Перечисления.AMS_ВидыСравнения.Больше);
	Результат.Вставить(Справочники.AMS_ВидыСравнения.Меньше,			 Перечисления.AMS_ВидыСравнения.Меньше);
	Результат.Вставить(Справочники.AMS_ВидыСравнения.Заполнено,			 Перечисления.AMS_ВидыСравнения.Заполнено);
	Результат.Вставить(Справочники.AMS_ВидыСравнения.НеЗаполнено,		 Перечисления.AMS_ВидыСравнения.НеЗаполнено);
	Результат.Вставить(Справочники.AMS_ВидыСравнения.ВСписке,			 Перечисления.AMS_ВидыСравнения.ВСписке);
	Результат.Вставить(Справочники.AMS_ВидыСравнения.НеВСписке,			 Перечисления.AMS_ВидыСравнения.НеВСписке);
	
	Возврат Результат;
	
КонецФункции


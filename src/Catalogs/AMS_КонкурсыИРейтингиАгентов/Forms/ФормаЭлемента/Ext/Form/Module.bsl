&НаКлиенте
Процедура ПроверитьЗаполнениеДанных(Отказ)

	Если ЗначениеЗаполнено(Объект.Родитель) Тогда
		Если Объект.ДоступенВсем Тогда
			
			Если Объект.Участники.Количество() > 0 Тогда
				ТекстСообщения = "Установлен флаг ""Доступен всем"". Необходимо очистить участников рейтинга.";
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,"Объект.ДоступенВсем",,Истина);
				Отказ = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		Если НЕ Объект.ДоступенВсем Тогда
			
			Если Объект.Участники.Количество() = 0 Тогда
				ТекстСообщения = "Необходимо добавить хотя бы одного участника рейтинга.";
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,"Объект.Участники",,Истина);
				Отказ = Истина;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;

	Для Каждого Строка Из Объект.КурсБалловРейтинга Цикл
		
		Если ЗначениеЗаполнено(Строка.ВидПродукта) И ЗначениеЗаполнено(Строка.Продукт) Тогда
			Индекс = Строка.НомерСтроки - 1;
			ТекстСообщения = "Необходимо заполнить только одно поле: либо Вид продукта либо Продукт";
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,"Объект.КурсБалловРейтинга[" + Индекс + "].ВидПродукта",,Истина);
			Отказ = Истина;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Строка.ВидПродукта) И НЕ ЗначениеЗаполнено(Строка.Продукт) Тогда	
			Индекс = Строка.НомерСтроки - 1;
			ТекстСообщения = "Необходимо заполнить одно поле: либо Вид продукта либо Продукт";
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,"Объект.КурсБалловРейтинга[" + Индекс + "].ВидПродукта",,Истина);
			Отказ = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Объект.ПриростПортфеляАгента Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.СрокДействияПрироста) Тогда
			ТекстСообщения = "Необходимо заполнить Срок действия прироста";
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,"Объект.СрокДействияПрироста",,Истина);
			Отказ = Истина;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.СрокДействия) Тогда
			ТекстСообщения = "Необходимо заполнить Срок действия";
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,"Объект.СрокДействия",,Истина);
			Отказ = Истина;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.УсловияНачисленияБалловЗаПрирост) Тогда
			ТекстСообщения = "Необходимо выбрать Условие начисление баллов за прирост";
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,"Объект.УсловияНачисленияБалловЗаПрирост",,Истина);
			Отказ = Истина;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьПоТипуМероприятия()
	
	Элементы.Условия.Видимость = Объект.ТипМероприятия = ПредопределенноеЗначение("Справочник.AMS_Мероприятия.Конкурс");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьПоПриростуПортфеляАгента()
	
	Элементы.СрокДействияПрироста.Видимость				 = Объект.ПриростПортфеляАгента;
	Элементы.СрокДействия.Видимость						 = Объект.ПриростПортфеляАгента;
	Элементы.УсловияНачисленияБалловЗаПрирост.Видимость	 = Объект.ПриростПортфеляАгента;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьПоУсловиюНачисления()
	
	Если Объект.ПриростПортфеляАгента Тогда
		
		Элементы.УсловиеПриростаПортфеля.Видимость = Истина;
		
		Элементы.УсловиеШкала.Видимость = Объект.УсловияНачисленияБалловЗаПрирост = 
											ПредопределенноеЗначение("Перечисление.УсловияНачисленияБалловЗаПрирост.Шкала");
											
		Элементы.УсловиеФиксированный.Видимость = Объект.УсловияНачисленияБалловЗаПрирост = 
											ПредопределенноеЗначение("Перечисление.УсловияНачисленияБалловЗаПрирост.Фиксированый");
	Иначе
		
		Элементы.УсловиеШкала.Видимость = Ложь;
		Элементы.УсловиеФиксированный.Видимость = Ложь;
		Элементы.УсловиеПриростаПортфеля.Видимость = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьУсловияПрироста()

	Если НЕ Элементы.УсловиеШкала.Видимость Тогда
		Объект.Шкала.Очистить();
	КонецЕсли;
	
	Если НЕ Элементы.УсловиеФиксированный.Видимость Тогда
		Объект.Фиксированный.Очистить();
	КонецЕсли;
	
	Если НЕ Объект.ПриростПортфеляАгента Тогда
		Объект.УсловияНачисленияБалловЗаПрирост = ПредопределенноеЗначение("Перечисление.УсловияНачисленияБалловЗаПрирост.ПустаяСсылка");
		Объект.СрокДействияПрироста = ПредопределенноеЗначение("Справочник.СрокДействияПрироста.ПустаяСсылка");
		Объект.СрокДействия = "";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура УсловияНачисленияБалловЗаПриростПриИзменении(Элемент)
	УстановитьВидимостьПоУсловиюНачисления();
КонецПроцедуры

&НаКлиенте
Процедура ПриростПортфеляАгентаПриИзменении(Элемент)
	УстановитьВидимостьПоПриростуПортфеляАгента();
	УстановитьВидимостьПоУсловиюНачисления();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ПроверитьЗаполнениеДанных(Отказ);
	ОчиститьУсловияПрироста();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.AMS_Филиалы") Тогда
		
		МассивАгентов = ПолучитьАгентовПоФилиалу(ВыбранноеЗначение);
		
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.AMS_Агенты") Тогда	
		
		МассивАгентов = ПолучитьАгентовПоАгенту(ВыбранноеЗначение);
		
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.AMS_КаналыПродаж") Тогда
		
		МассивАгентов = ПолучитьАгентовПоКаналам(ВыбранноеЗначение);
		
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Кураторы") Тогда
		
		МассивАгентов = ПолучитьАгентовПоКураторам(ВыбранноеЗначение);
		
	КонецЕсли;
	
	ЗаполнитьУчастников(МассивАгентов);
	
КонецПроцедуры

&НаКлиенте
Процедура КурсБалловРейтингаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		Объект.КурсБалловРейтинга[Объект.КурсБалловРейтинга.Количество()-1].ИдентификаторСтроки = ПолучитьУИД();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимостьПоПриростуПортфеляАгента();
	УстановитьВидимостьПоТипуМероприятия();
	УстановитьВидимостьПоУсловиюНачисления();
	УстановитьВидимостьСтрок();
КонецПроцедуры

&НаКлиенте
Процедура ТипМероприятияПриИзменении(Элемент)
	УстановитьВидимостьПоТипуМероприятия();
КонецПроцедуры

&НаКлиенте
Процедура УчастникиИсключенияАгентПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.УчастникиИсключения.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;

	ТекущиеДанные.ИдентификаторАгента = ИдентификаторАгента(ТекущиеДанные.Агент);
	
КонецПроцедуры

&НаКлиенте
Процедура УсловияПриростаПортфеляПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Объект.УсловияПриростаПортфеля.Количество() > 0;
КонецПроцедуры

&НаКлиенте
Процедура ФиксированныйПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Объект.Фиксированный.Количество() > 0;
КонецПроцедуры

&НаКлиенте
Процедура УчастникиПриИзменении(Элемент)
	УстановитьВидимостьСтрок();
КонецПроцедуры

&НаКлиенте
Процедура УчастникиПриАктивизацииСтроки(Элемент)
	УстановитьВидимостьСтрок();
КонецПроцедуры

&НаКлиенте
Процедура УчастникиПередУдалением(Элемент, Отказ)
	
	ИндексСтроки = Объект.Участники.Индекс(Элементы.Участники.ТекущиеДанные);
	ВыделеннаяСтрока = Объект.Участники.Получить(ИндексСтроки);
	КлючСвязи = ВыделеннаяСтрока.КлючСвязи;
	
	НулевыеСтроки = Объект.УчастникиИсключения.НайтиСтроки(Новый Структура("КлючСвязи", КлючСвязи));
	
	Для каждого СтрокаТаблицы Из НулевыеСтроки Цикл
		
		Объект.УчастникиИсключения.Удалить(СтрокаТаблицы);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УчастникиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		Объект.Участники[Объект.Участники.Количество()-1].КлючСвязи = ПолучитьУИД();
		
	КонецЕсли;
	
	УстановитьВидимостьСтрок();
	
КонецПроцедуры

&НаКлиенте
Процедура УчастникиИсключенияПриИзменении(Элемент)
	
	ИндексСтрокиУсловия = Объект.Участники.Индекс(Элементы.Участники.ТекущиеДанные);
	ВыделеннаяСтрока = Объект.Участники.Получить(ИндексСтрокиУсловия);
	КлючСвязи = ВыделеннаяСтрока.КлючСвязи;
	
	Для каждого Стр Из Объект.УчастникиИсключения Цикл
		
		Если Не ЗначениеЗаполнено(Стр.КлючСвязи) Тогда
			
			Стр.КлючСвязи = КлючСвязи;
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УчастникиИсключенияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Объект.Участники.Количество() <> 0 Тогда
		ИндексСтрокиУсловия = Объект.Участники.Индекс(Элементы.Участники.ТекущиеДанные);
		ВыделеннаяСтрока = Объект.Участники.Получить(ИндексСтрокиУсловия);
	Иначе
		Отказ = Истина;
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо добавить участников",,"Объект.Участники",,Истина);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Очистить(Команда)
	Объект.Участники.Очистить();
	Объект.УчастникиИсключения.Очистить();
	ЭтаФорма.Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура Агент(Команда)
	
	ПараметрыФормы = Новый Структура("ЗакрыватьПриВыборе, РежимВыбора", Ложь, Истина);
	
	ОткрытьФорму("Справочник.AMS_Агенты.ФормаВыбора", ПараметрыФормы, 
	ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура Канал(Команда)
	
	ПараметрыФормы = Новый Структура("ЗакрыватьПриВыборе, РежимВыбора", Ложь, Истина);
	
	ОткрытьФорму("Справочник.AMS_КаналыПродаж.ФормаВыбора", ПараметрыФормы, 
	ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура Филиал(Команда)
	
	ПараметрыФормы = Новый Структура("ЗакрыватьПриВыборе, РежимВыбора", Ложь, Истина);
	
	ОткрытьФорму("Справочник.AMS_Филиалы.ФормаВыбора", ПараметрыФормы, 

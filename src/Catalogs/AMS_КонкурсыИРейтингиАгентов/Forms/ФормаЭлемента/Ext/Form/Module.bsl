КонецПроцедуры

&НаКлиенте
Процедура Куратор(Команда)
	
	ПараметрыФормы = Новый Структура("ЗакрыватьПриВыборе, РежимВыбора", Ложь, Истина);
	
	ОткрытьФорму("Справочник.Кураторы.ФормаВыбора", ПараметрыФормы, 
	ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьВидимостьСтрок()
	
	ТекущиеДанные = Элементы.Участники.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КлючСвязи = ТекущиеДанные.КлючСвязи;
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("КлючСвязи", КлючСвязи);
	Элементы.УчастникиИсключения.ОтборСтрок = Новый ФиксированнаяСтруктура(СтруктураПоиска);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИдентификаторАгента(Агент)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Агент, "ГУИД")
	
КонецФункции	

&НаСервереБезКонтекста
Функция ПолучитьУИД()
	Возврат Новый УникальныйИдентификатор();
КонецФункции

&НаСервере
Процедура ЗаполнитьУчастников(МассивАгентов)
	
	Для каждого Агент Из МассивАгентов Цикл 
		
		Отбор = Новый Структура("Агент", Агент.Агент);
		СтрокиТабличнойЧасти = Объект.Участники.НайтиСтроки(Отбор);
		
		Если СтрокиТабличнойЧасти.Количество() = 0 Тогда
			
			СтрокаУчастников = Объект.Участники.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаУчастников, Агент);
			
			Если НЕ ЗначениеЗаполнено(СтрокаУчастников.КлючСвязи) Тогда
				СтрокаУчастников.КлючСвязи = ПолучитьУИД();
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Объект.МероприятиеКуратора Тогда
		
		ВременнаяТаблицаУчастников = Объект.Участники.Выгрузить();	
		ВременнаяТаблицаУчастников.Свернуть("Филиал, Куратор, КлючСвязи");
		ВременнаяТаблицаУчастников.Колонки.Добавить("Агент");
		ВременнаяТаблицаУчастников.Колонки.Добавить("ИдентификаторАгента");
		ВременнаяТаблицаУчастников.Колонки.Добавить("СтатусАгента");
		
		Объект.Участники.Загрузить(ВременнаяТаблицаУчастников);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьАгентовПоФилиалу(ВыбранноеЗначение)
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	AMS_АгентскиеДоговоры.Владелец КАК Владелец,
	|	AMS_АгентскиеДоговоры.Филиал КАК Филиал
	|ИЗ
	|	Справочник.AMS_АгентскиеДоговоры КАК AMS_АгентскиеДоговоры
	|ГДЕ
	|	AMS_АгентскиеДоговоры.Филиал = &Филиал";
	
	Запрос.УстановитьПараметр("Филиал", ВыбранноеЗначение);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СтруктураДанных = Новый Структура;
		
		СтруктураДанных.Вставить("Агент", 	 Выборка.Владелец);
		СтруктураДанных.Вставить("Филиал", 	 Выборка.Филиал);
		
		Результат.Добавить(СтруктураДанных);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции


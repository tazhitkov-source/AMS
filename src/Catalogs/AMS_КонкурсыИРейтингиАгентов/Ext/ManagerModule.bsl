#Область СлужебныеПроцедуры

Процедура ОбработатьОшибкуВЖурналРегистрации(ОбъектСсылка);
	
	СтруктураСобытий = Новый Структура("ИмяСобытия, ПредставлениеУровня, Комментарий,ДатаСобытия");
	СтруктураСобытий.ИмяСобытия 		 = "Обмен с МАМС(MasterAMS)";
	СтруктураСобытий.ПредставлениеУровня = "Ошибка";
	СтруктураСобытий.Комментарий 		 = "Обмен RatingIncreaseCriteria с MAMS завершился с ошибкой. Не заполнен Прирост портфеля агента в документе" + ОбъектСсылка;
	СтруктураСобытий.ДатаСобытия 		 = ТекущаяДатаСеанса();
	
	СобытияДляЖурналаРегистрации = Новый СписокЗначений();
	СобытияДляЖурналаРегистрации.Добавить(СтруктураСобытий);
	
	ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СобытияДляЖурналаРегистрации);
	
КонецПроцедуры

#КонецОбласти

#Область ИнтеграцияМАМС

Функция СформироватьСообщениеДляМАМС(ОбъектСсылка) Экспорт
	
	Результат = Новый Массив;
	
	ЗаполнитьДанныеРейтинга(ОбъектСсылка, Результат);
	ЗаполнитьДанныеУчастниковРейтингов(ОбъектСсылка, Результат);
	ЗаполнитьДанныеКурсыБалов(ОбъектСсылка, Результат);
	ЗаполнитьДанныеУсловияПриростаПортфеля(ОбъектСсылка, Результат);
	
	Возврат Результат;
	
КонецФункции	



Процедура ПриКопировании(ОбъектКопирования)
	ГУИД = "";
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	Если Не ЗначениеЗаполнено(ГУИД) Тогда
		ГУИД = Строка(Новый УникальныйИдентификатор());
	КонецЕсли; 
	
	Для каждого СтрокаГрафика Из График Цикл
	
		Если НЕ ЗначениеЗаполнено(СтрокаГрафика.ИдентификаторСтроки) Тогда
			 СтрокаГрафика.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;	 			
	
	КонецЦикла;
	
КонецПроцедуры

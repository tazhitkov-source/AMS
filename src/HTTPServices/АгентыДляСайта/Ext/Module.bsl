
Функция ОсновнойПолучениеКонтрагентов(Запрос)

	ДанныеПоАгентам = AMS_АгентыДляСайтаСервер.ПолучитьДанныеПоАгентам();		
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ДанныеПоАгентам);
	
	Возврат Ответ;
КонецФункции
